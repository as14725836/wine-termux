+        {&MEDIATYPE_Video, &MEDIASUBTYPE_RGB32},
+        {&MEDIATYPE_Video, &MEDIASUBTYPE_RGB24},
+        {&MEDIATYPE_Video, &MEDIASUBTYPE_RGB565},
