+
     static const REGPINTYPES avi_splitter_inputs[] =
     {
         {&MEDIATYPE_Stream, &MEDIASUBTYPE_Avi},
@@ -579,6 +601,9 @@
     if (FAILED(hr = IFilterMapper2_RegisterFilter(mapper, &CLSID_CMpegVideoCodec, L"MPEG Video Decoder", NULL,
