class WinComponentsDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self._drag_pos = None
        self._drag_start_global = None
        self._dragging = False
        self._server = None
        self._busy = False

        # 组件目录（带缓存）+ 当前 prefix 的 appid
        self.catalog = []
        self.catalog_src = "?"
        self.catalog_err = None
        self.prefix = wine_prefix_dir()
        self.appid = appid_for_prefix(self.prefix) or "default"
        self._installed = set(installed_ids(self.appid, self.prefix))
        self._cur_win = read_current_windows_version()
        self.init_ui()
        self._refresh_catalog()

    def _refresh_catalog(self, force=False):
        """先把缓存的目录画出来，同时后台去拉最新的。"""
        comps, src, err = catalog_components(force=False)
        if comps:
            self.catalog, self.catalog_src, self.catalog_err = comps, src, None
            self._filter(self.search_edit.text())
        t, box = _worker(lambda: catalog_components(force=force))

        def check():
            if not box["done"]:
                QTimer.singleShot(150, check)
                return
            if box["error"]:
                if not self.catalog:
                    self.status_label.setText("组件目录拉取失败：%s" % box["error"])
                return
            comps, src, err = box["result"]
            if comps:
                self.catalog, self.catalog_src, self.catalog_err = comps, src, None
                self._filter(self.search_edit.text())
        QTimer.singleShot(150, check)

    def bind_single_instance_server(self, server):
        self._server = server

        def _on_new_conn():
            conn = server.nextPendingConnection()
            if conn is None:
                return
            try:
                if self.isMinimized():
                    self.showNormal()
                self.show()
                self.raise_()
                self.activateWindow()
            finally:
                conn.disconnectFromServer()
                conn.deleteLater()

        server.newConnection.connect(_on_new_conn)

