def store_dir():
    """组件 store：wc-install 下载解包后的落点。

    默认 ~/.local/share/wincomponents（wc-install / wc-apply 自己的默认），
    也可以用 WC_STORE 环境变量指到别处；界面上看到的组件就来自这里。
    """
    return os.environ.get("WC_STORE") or os.path.join(
        os.path.expanduser("~"), ".local", "share", "wincomponents")


def list_versions():
    """列出所有可用组件，返回 [(显示名, 路径)] —— 和 DXVK 那版同形。

    两个来源：
      · store 里已经装好的组件（wc-install 下的），路径就是 store/<id>
      · usr/wincomponents/*.tar.xz 本地包（和 usr/dxvk/*.tar.gz 平行）
    同名只列一次，store 优先（store 才带 overrides / 注册表信息）。
    """
    seen = {}
    st = store_dir()
    if os.path.isdir(st):
        for d in sorted(os.listdir(st)):
            full = os.path.join(st, d)
            if d.startswith(".") or not os.path.isdir(full):
                continue
            seen[d] = full
    if os.path.isdir(PKG_DIR):
        for f in sorted(os.listdir(PKG_DIR)):
            for suf in (".tar.xz", ".tar.gz"):
                if f.endswith(suf):
                    name = f[:-len(suf)]
                    seen.setdefault(name, os.path.join(PKG_DIR, f))
                    break
    return sorted(seen.items())


def read_installed():
    """当前 prefix 里已经装过哪些组件（wc-apply 的状态文件）。"""
    pfx = wine_prefix_dir()
    if not pfx:
        return []
    # 状态文件位置按优先级：给裸 .wine prefix 用的批处理目录 -> prefix 自己旁边
    cands = []
    try:
        cands.append(os.path.join(_compat_for_prefix(pfx), ".wc-apply.json"))
    except Exception:
        pass
    cands += [
        os.path.join(os.path.dirname(pfx), ".wc-apply.json"),
        os.path.join(pfx, ".wc-apply.json"),
        os.path.join(pfx, "..", ".wc-apply.json"),
    ]
    for cand in cands:
        try:
            with open(cand, "r") as f:
                return json.load(f).get("components", [])
        except Exception:
            continue
    return []


