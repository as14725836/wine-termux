            b.setToolTip("把 prefix 报成 " + val)
            if val == self._cur_win:
                b.setChecked(True)
            self.win_group.addButton(b, i)
            self.win_btns[val] = b
            row_win.addWidget(b)
            b.clicked.connect(lambda ch, v=val: self._set_win(v))
        row_win.addStretch()

        # ── 一键组合 / 删除 ──
        row_cfg = QHBoxLayout()
        row_cfg.setSpacing(6)
        lab_cfg = QLabel("一键")
        lab_cfg.setObjectName("setLabel")
        row_cfg.addWidget(lab_cfg)
        for label, ids in BUNDLES:
            b = QPushButton(label)
            b.setObjectName("setBtn")
            b.setToolTip("装：" + ", ".join(ids))
            b.clicked.connect(lambda ch, i=ids, l=label: self._install_bundle(l, i))
            row_cfg.addWidget(b)
        row_cfg.addStretch()

        delb = QPushButton("删除…")
        delb.setObjectName("delBtn")
        delb.setToolTip("勾选要删掉的包（可多选）后一次性删除")
        delb.clicked.connect(self._delete_multi)
        row_cfg.addWidget(delb)

        cancel = QPushButton("取消")
        cancel.setObjectName("cancelBtn")
        cancel.clicked.connect(self.reject)
        row_cfg.addWidget(cancel)

        layout.addLayout(row_win)
        layout.addLayout(row_cfg)

        self.setLayout(layout)
        self._install_drag_filter(self)
        self._filter("")

    def _install_drag_filter(self, parent):
        for child in parent.findChildren(QWidget):
            if child is self.search_edit:
                continue
            if isinstance(child, QPushButton) and child.objectName() in ("verBtn", "setBtn"):
                continue
            try:
                child.installEventFilter(self)
            except Exception:
                pass

    def _set_win(self, val):
        ok = write_windows_version(val)
        b = self.win_btns.get(val)
        if b is not None:
            b.setChecked(True)
        if ok:
            self._cur_win = val
            self.status_label.setText("版本已切到 " + val)
        else:
            self.status_label.setText("切换版本失败")

    def _install_bundle(self, label, ids):
        n = len(ids)
        self.status_label.setText("正在装「%s」…（%d 个）" % (label, n))
        QApplication.processEvents()
        ok, msg = apply_selection(ids)
        self.status_label.setText(msg if ok else "失败：" + msg)

    def _fit_width(self):
        mbw = getattr(self, "_max_btn_w", 0)
        if mbw <= 0:
            return
        need = mbw + 96
        scr = QApplication.primaryScreen()
        avail = scr.availableGeometry().width() if scr is not None else 1080
        cap = int(avail * 0.96)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        if need > cap:
            need = cap
        if need < 420:
            need = 420
        if self.minimumWidth() < need:
            self.setMinimumWidth(need)
        if self.width() < need:
            self.resize(need, self.height())

    def _update_scroll_size(self):
        vp = self.scroll.viewport()
        if vp is None:
            return
        w = vp.width()
        if w < 50:
            w = 400
        h = self.flow.heightForWidth(w)
        if h < 100:
            h = 100
        self.flow_widget.setFixedSize(w, h)

    def _filter(self, text):
        while self.flow.count():
            item = self.flow.takeAt(0)
            w = item.widget()
            if w:
                w.deleteLater()

        low = text.lower().strip()
        count = 0
        maxw = 0
        installed = set(read_installed())

        for name, path in self.all_versions:
            if low in name.lower():
                label = name + ("  ✓" if name in installed else "")
                btn = QPushButton(label)
                btn.setObjectName("verBtn")
                btn.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Fixed)
                btn.setToolTip("%s\n%s" % (name, path))
                btn.clicked.connect(lambda checked, p=path: self._install_version(p))
                btn.installEventFilter(self)
                self.flow.addWidget(btn)
                btn.ensurePolished()
                maxw = max(maxw, btn.sizeHint().width())
                count += 1

        self._max_btn_w = maxw
        if count:
            self.status_label.setText("共 %d 个组件　·　%s" % (count, env_summary()))
        else:
            self.status_label.setText("没有组件包（放进 %s）" % PKG_DIR)
        QTimer.singleShot(0, self._fit_width)
        QTimer.singleShot(0, self._update_scroll_size)

    def _install_version(self, path):
        """安装组件（无提示）"""
        ok, msg = install_component(path)
        self.all_versions = list_versions()
        self._filter(self.search_edit.text())
        self.status_label.setText(msg if ok else "失败：" + msg)

    def _delete_multi(self):
        items = list(self.all_versions)
        if not items:
            self.status_label.setText("没有可删除的包")
            return
        picks = _ask_delete_multi(items, self)
        if not picks:
            return
        done = failed = 0
        freed = 0
        for path, name, is_current in picks:
            try:
                freed += os.path.getsize(path)
            except Exception:
                pass
            ok, msg = delete_package(path, None, is_current)
            if ok:
                done += 1
            else:
                failed += 1
        self.all_versions = list_versions()
        self._filter(self.search_edit.text())
        txt = "已删除 %d 个包（%s）" % (done, _human_size(freed))
        if failed:
            txt += "，%d 个失败" % failed
        self.status_label.setText(txt)

    def _delete_version(self, path, name, is_current=False):
        ok, msg = delete_package(path, self, is_current)
        if ok:
            self.all_versions = list_versions()
            self._filter(self.search_edit.text())
            self.status_label.setText(msg)
        elif msg != "已取消":
            self.status_label.setText(msg)

    def eventFilter(self, obj, event):
        if event.type() == event.MouseButtonPress:
            if event.button() == Qt.LeftButton:
                if isinstance(obj, QScrollBar) or obj.parent() and isinstance(obj.parent(), QScrollBar):
                    return super().eventFilter(obj, event)
                if isinstance(obj, QScrollArea):
                    return super().eventFilter(obj, event)
                gp = event.globalPos()
                fg = self.frameGeometry()
                margin = 8
                self._resize_edge = None
                if gp.x() >= fg.right() - margin and gp.y() >= fg.bottom() - margin:
                    self._resize_edge = "se"
                elif gp.x() >= fg.right() - margin:
                    self._resize_edge = "e"
                elif gp.y() >= fg.bottom() - margin:
                    self._resize_edge = "s"
                if self._resize_edge:
                    self._resize_start_pos = gp
                    self._resize_start_geo = fg
                    return True
                self._drag_pos = gp - fg.topLeft()
                self._drag_start_global = gp
                self._dragging = False
        elif event.type() == event.MouseMove:
            gp = event.globalPos()
            fg = self.frameGeometry()
            margin = 8
            if hasattr(self, '_resize_edge') and self._resize_edge:
                delta = gp - self._resize_start_pos
                sg = self._resize_start_geo
                new_geo = sg
                if "e" in self._resize_edge:
                    new_geo.setRight(max(sg.left() + self.minimumWidth(),
                                         sg.right() + delta.x()))
                if "s" in self._resize_edge:
                    new_geo.setBottom(max(sg.top() + self.minimumHeight(),
                                          sg.bottom() + delta.y()))
                self.setGeometry(new_geo)
                return True
            if event.buttons() == Qt.LeftButton and self._drag_pos is not None:
                if not self._dragging:
                    if (gp - self._drag_start_global).manhattanLength() > 6:
                        self._dragging = True
                if self._dragging:
                    self.move(gp - self._drag_pos)
                    return True
            if gp.x() >= fg.right() - margin and gp.y() >= fg.bottom() - margin:
                self.setCursor(Qt.SizeFDiagCursor)
            elif gp.x() >= fg.right() - margin:
                self.setCursor(Qt.SizeHorCursor)
            elif gp.y() >= fg.bottom() - margin:
                self.setCursor(Qt.SizeVerCursor)
            else:
                self.setCursor(Qt.ArrowCursor)
        elif event.type() == event.MouseButtonRelease:
            self._drag_pos = None
            self._dragging = False
            self._resize_edge = None
            self.setCursor(Qt.ArrowCursor)
        return super().eventFilter(obj, event)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        gradient = QLinearGradient(0, 0, 0, self.height())
        gradient.setColorAt(0, QColor(42, 58, 95))
        gradient.setColorAt(1, QColor(24, 32, 58))
        painter.setBrush(gradient)
        painter.setPen(Qt.NoPen)
        painter.drawRoundedRect(QRectF(self.rect()), 22, 22)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        path = QPainterPath()
        path.addRoundedRect(QRectF(self.rect()), 22, 22)
        self.setMask(QRegion(path.toFillPolygon().toPolygon()))
        QTimer.singleShot(0, self._update_scroll_size)


