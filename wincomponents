class _DelPickDialog(QDialog):
    """多选删除窗：一份列表全打勾，点「删除选中」一次删掉"""

    def __init__(self, items, parent=None):
        super().__init__(parent)
        # items 可能是 (name, path) 或 (name, path, is_current) 两种形状
        norm = []
        for it in items:
            if len(it) >= 3:
                norm.append((it[0], it[1], bool(it[2])))
            else:
                norm.append((it[0], it[1], False))
        norm.sort(key=lambda x: x[0].lower())
        self._boxes = []
        self._drag = None

        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Window | Qt.WindowStaysOnTopHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setStyleSheet(_DELPICK_STYLE)

        lay = QVBoxLayout(self)
        lay.setContentsMargins(30, 26, 30, 22)
        lay.setSpacing(12)

        t = QLabel("删除包（可多选）")
        t.setObjectName("pickTitle")
        lay.addWidget(t)

        sub = QLabel("勾选要删掉的包，再点「删除选中」。共 %d 个" % len(norm))
        sub.setObjectName("pickSub")
        lay.addWidget(sub)

        area = QScrollArea()
        area.setWidgetResizable(True)
        area.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)   # 不要左右滚动条
        area.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        area.setFrameShape(QFrame.NoFrame)
        area.setStyleSheet("QScrollArea { background: transparent; border: none; }")
        holder = QWidget()
        holder.setStyleSheet("background: transparent;")
        v = QVBoxLayout(holder)
        v.setContentsMargins(2, 2, 2, 2)
        v.setSpacing(4)
        for nm, path, cur in norm:
            cb = QCheckBox()
            cb.setObjectName("pickBox")
            txt = nm + ("　★当前" if cur else "")
            try:
                txt += "　·　" + _human_size(os.path.getsize(path))
            except Exception:
                pass
            cb.setText(txt)
            cb.setToolTip(path)
            cb.toggled.connect(self._sync)
            v.addWidget(cb)
            self._boxes.append((cb, path, nm, cur))
        v.addStretch()
        area.setWidget(holder)
        lay.addWidget(area, 1)

        self._hint = QLabel("")
        self._hint.setObjectName("pickHint")
        self._hint.setWordWrap(True)
        lay.addWidget(self._hint)

        row = QHBoxLayout()
        allb = QPushButton("全选")
        allb.setObjectName("pickMini")
        allb.clicked.connect(lambda: self._set_all(True))
        row.addWidget(allb)
        noneb = QPushButton("清空")
        noneb.setObjectName("pickMini")
        noneb.clicked.connect(lambda: self._set_all(False))
        row.addWidget(noneb)
        row.addStretch()
        no = QPushButton("取消")
        no.setObjectName("delCancelBtn")
        no.setDefault(True)
        no.clicked.connect(self.reject)
        row.addWidget(no)
        self._ok = QPushButton("删除选中")
        self._ok.setObjectName("delOkBtn")
        self._ok.clicked.connect(self.accept)
        row.addWidget(self._ok)
        lay.addLayout(row)

        self._sync()
        try:
            scr = QApplication.primaryScreen().availableGeometry()
            self.resize(min(760, scr.width() - 60), min(580, int(scr.height() * 0.82)))
            self.move(scr.center().x() - self.width() // 2,
                      scr.center().y() - self.height() // 2)
        except Exception:
            self.setMinimumSize(640, 460)

    def _set_all(self, on):
        for cb, _p, _n, _c in self._boxes:
            cb.setChecked(on)

    def _sync(self):
        sel = [x for x in self._boxes if x[0].isChecked()]
        n = len(sel)
        self._ok.setEnabled(n > 0)
        self._ok.setText("删除选中" if n == 0 else "删除选中（%d）" % n)
        if any(x[3] for x in sel):
            self._hint.setText("⚠ 勾选里有当前正在使用的版本：删掉只是删了这个包，已装好的内容还在。")
        else:
            self._hint.setText("")

    def picked(self):
        return [(p, n, c) for cb, p, n, c in self._boxes if cb.isChecked()]

    # ↓ 外观 / 拖动 / ESC（跟删除确认窗同一套）
    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        g = QLinearGradient(0, 0, 0, self.height())
        g.setColorAt(0, QColor(42, 58, 95))
        g.setColorAt(1, QColor(24, 32, 58))
        p.setBrush(g)
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(self.rect()), 22, 22)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        path = QPainterPath()
        path.addRoundedRect(QRectF(self.rect()), 22, 22)
        self.setMask(QRegion(path.toFillPolygon().toPolygon()))

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton and event.pos().y() < 70:
            self._drag = event.globalPos() - self.frameGeometry().topLeft()

    def mouseMoveEvent(self, event):
        if self._drag is not None and event.buttons() == Qt.LeftButton:
            self.move(event.globalPos() - self._drag)

    def mouseReleaseEvent(self, event):
        self._drag = None

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.reject()
        else:
            super().keyPressEvent(event)


def _ask_delete_multi(items, parent=None):
    """弹多选删除窗。返回 [(path, name, is_current), ...]；取消/没选 = 空表"""
    try:
        dlg = _DelPickDialog(items, parent)
        if dlg.exec_() == QDialog.Accepted:
            return dlg.picked()
        return []
    except Exception:
        return []


def delete_package(path, parent=None, is_current=False):
    """直接删除一个包文件。返回 (是否已删除, 提示文字)"""
    try:
        path = os.path.abspath(str(path))
        if not os.path.exists(path):
            return False, "文件不存在：" + os.path.basename(path)
        if not os.path.isfile(path):
            return False, "不是普通文件，没删"
        if ALLOW_PKG_DIR and os.path.dirname(path) != os.path.abspath(ALLOW_PKG_DIR):
            return False, "不在允许目录里，没删"
        name = os.path.basename(path)
        try:
            size = os.path.getsize(path)
        except Exception:
            size = 0
        if DELETE_CONFIRM and parent is not None:
            if not _ask_delete(name, size, is_current, parent):
                return False, "已取消"
        os.remove(path)
        return True, "已删除 %s（%s）" % (name, _human_size(size))
    except Exception as ex:
        return False, "删除失败：%s" % ex


