def _human_size(n):
    try:
        n = float(n)
        for u in ("B", "KB", "MB", "GB"):
            if n < 1024 or u == "GB":
                return ("%.0f %s" % (n, u)) if u == "B" else ("%.1f %s" % (n, u))
            n /= 1024
    except Exception:
        pass
    return "?"


