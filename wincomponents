    def _install_drag_filter(self, parent):
        for child in parent.findChildren(QWidget):
            if child is self.search_edit:
                continue
            if isinstance(child, QPushButton) and child.objectName() in ("verBtn", "setBtn"):
                continue
            try:
                child.installEventFilter(self)
            except Exception:
                pass

    def _set_win(self, val):
        ok = write_windows_version(val)
        b = self.win_btns.get(val)
        if b is not None:
            b.setChecked(True)
        if ok:
            self._cur_win = val
            self.status_label.setText("版本已切到 " + val)
        else:
            self.status_label.setText("切换版本失败")

    def _install_bundle(self, label, ids):
        if self._busy:
            return
        # 目录里存在的那几个才装
        have = {c.get("name") for c in self.catalog}
        todo = [i for i in ids if i in have][:8]
        if not todo:
            self.status_label.setText("「%s」里的组件目录里都没有" % label)
            return
        self._set_busy(True, "正在装「%s」…（%d 个）" % (label, len(todo)))
        QApplication.processEvents()

        def work():
            done = []
            for n in todo:
                try:
                    install_one(n, self.appid, self.catalog, pfx=self.prefix)
                    done.append(n)
                except Exception:
                    pass
            return done

        t, box = _worker(work)

        def check():
            if not box["done"]:
                QTimer.singleShot(250, check)
                return
            self._set_busy(False)
            self._installed = set(installed_ids(self.appid, self.prefix))
            self._filter(self.search_edit.text())
            if box["error"]:
                self.status_label.setText("「%s」失败：%s" % (label, box["error"]))
            else:
                self.status_label.setText("「%s」已装 %d 个" % (label, len(box["result"])))
        QTimer.singleShot(250, check)

    def _fit_width(self):
        mbw = getattr(self, "_max_btn_w", 0)
        if mbw <= 0:
            return
        need = mbw + 96
        scr = QApplication.primaryScreen()
        avail = scr.availableGeometry().width() if scr is not None else 1080
        cap = int(avail * 0.96)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        if need > cap:
            need = cap
        if need < 420:
            need = 420
        if self.minimumWidth() < need:
            self.setMinimumWidth(need)
        if self.width() < need:
            self.resize(need, self.height())

    def _update_scroll_size(self):
        vp = self.scroll.viewport()
        if vp is None:
            return
        w = vp.width()
        if w < 50:
            w = 400
        h = self.flow.heightForWidth(w)
        if h < 100:
            h = 100
        self.flow_widget.setFixedSize(w, h)

    def _filter(self, text):
        while self.flow.count():
            item = self.flow.takeAt(0)
            w = item.widget()
            if w:
                w.deleteLater()

        low = text.lower().strip()
        count = 0
        maxw = 0
        shown = 0
        skipped = 0
        for c in self.catalog:
            name = c.get("name") or "?"
            desc = (c.get("description") or "").replace("\n", " ").strip()
            kind, why = component_kind(c)
            if kind != "file":
                skipped += 1
                continue
            blob = (name + " " + desc).lower()
            if low and low not in blob:
                continue
            shown += 1
            size = component_size(c)
            mark = "  ✓" if name in self._installed else ""
            btn = QPushButton(name + mark)
            btn.setObjectName("verBtn")
            btn.setSizePolicy(QSizePolicy.Preferred, QSizePolicy.Fixed)
            tip = "%s\n%s\n%s" % (name, desc or "(无描述)",
                                   ("大小 " + human_size(size)) if size else "")
            if name in self._installed:
                tip += "\n状态：已安装（再点一下重新装）"
            btn.setToolTip(tip)
            btn.clicked.connect(lambda checked, n=name: self._click_component(n))
            btn.installEventFilter(self)
            self.flow.addWidget(btn)
            btn.ensurePolished()
            maxw = max(maxw, btn.sizeHint().width())
            count += 1

        self._max_btn_w = maxw
        if count:
            extra = "　·　还有 %d 个需要 Windows 安装器" % skipped if skipped else ""
            src_txt = {"cache": "本地缓存", "net": "在线"}.get(self.catalog_src, self.catalog_src)
            self.status_label.setText("可安装 %d 个组件（%s）%s　·　%s"
                                      % (count, src_txt, extra, env_summary()))
        elif self.catalog:
            self.status_label.setText("没有匹配的组件　·　%s" % env_summary())
        else:
            self.status_label.setText("正在获取组件目录…")
        QTimer.singleShot(0, self._fit_width)
        QTimer.singleShot(0, self._update_scroll_size)

    def _set_busy(self, busy, text=None):
        self._busy = busy
        if text:
            self.status_label.setText(text)
        for b in self.findChildren(QPushButton):
            if b.objectName() in ("verBtn", "setBtn"):
                b.setEnabled(not busy)

    def _click_component(self, name):
        """点卡片 = 没装就装、装了再点就重装（卸载走「删除…」）。"""
        if self._busy:
            return
        self._set_busy(True, "正在安装 %s …（下载 + 解包）" % name)
        QApplication.processEvents()

        def work():
            return install_one(name, self.appid, self.catalog, pfx=self.prefix)

        t, box = _worker(work)

        def check():
            if not box["done"]:
                QTimer.singleShot(200, check)
                return
            self._set_busy(False)
            if box["error"]:
                self.status_label.setText("安装 %s 失败：%s" % (name, box["error"]))
                return
            ok, msg = box["result"]
            self._installed = set(installed_ids(self.appid, self.prefix))
            self._filter(self.search_edit.text())
            self.status_label.setText(msg if ok else "失败：" + msg)
        QTimer.singleShot(200, check)

    def _delete_multi(self):
        """卸载：勾选已装组件，从 prefix 里撤掉（会还原被覆盖的原文件）。"""
        if self._busy:
            return
        items = [(n, n) for n in sorted(self._installed)]
        if not items:
            self.status_label.setText("当前 prefix 没有装任何组件")
            return
        picks = _ask_delete_multi(items, self)
        if not picks:
            return
        # _ask_delete_multi 返回 [(path, name, is_current), ...]
        names = []
        for entry in picks:
            if isinstance(entry, (tuple, list)):
                names.append(entry[1] if len(entry) >= 2 else entry[0])
            else:
                names.append(entry)
        if not names:
            return
        self._set_busy(True, "正在卸载 %d 个组件…" % len(names))
        QApplication.processEvents()

        def work():
            ids = read_selection(self.appid)
            for n in names:
                ids = [i for i in ids if i != n]
            do_apply(self.appid, ids, pfx=self.prefix)
            return names

        t, box = _worker(work)

        def check():
            if not box["done"]:
                QTimer.singleShot(200, check)
                return
            self._set_busy(False)
            if box["error"]:
                self.status_label.setText("卸载失败：%s" % box["error"])
                return
            self._installed = set(installed_ids(self.appid, self.prefix))
            self._filter(self.search_edit.text())
            self.status_label.setText("已卸载 %d 个组件" % len(box["result"]))
        QTimer.singleShot(200, check)

    def eventFilter(self, obj, event):
        if event.type() == event.MouseButtonPress:
            if event.button() == Qt.LeftButton:
                if isinstance(obj, QScrollBar) or obj.parent() and isinstance(obj.parent(), QScrollBar):
                    return super().eventFilter(obj, event)
                if isinstance(obj, QScrollArea):
                    return super().eventFilter(obj, event)
                gp = event.globalPos()
                fg = self.frameGeometry()
                margin = 8
                self._resize_edge = None
                if gp.x() >= fg.right() - margin and gp.y() >= fg.bottom() - margin:
                    self._resize_edge = "se"
                elif gp.x() >= fg.right() - margin:
                    self._resize_edge = "e"
                elif gp.y() >= fg.bottom() - margin:
                    self._resize_edge = "s"
                if self._resize_edge:
                    self._resize_start_pos = gp
                    self._resize_start_geo = fg
                    return True
                self._drag_pos = gp - fg.topLeft()
                self._drag_start_global = gp
                self._dragging = False
        elif event.type() == event.MouseMove:
            gp = event.globalPos()
            fg = self.frameGeometry()
            margin = 8
            if hasattr(self, '_resize_edge') and self._resize_edge:
                delta = gp - self._resize_start_pos
                sg = self._resize_start_geo
                new_geo = sg
                if "e" in self._resize_edge:
                    new_geo.setRight(max(sg.left() + self.minimumWidth(),
                                         sg.right() + delta.x()))
                if "s" in self._resize_edge:
                    new_geo.setBottom(max(sg.top() + self.minimumHeight(),
                                          sg.bottom() + delta.y()))
                self.setGeometry(new_geo)
                return True
            if event.buttons() == Qt.LeftButton and self._drag_pos is not None:
                if not self._dragging:
                    if (gp - self._drag_start_global).manhattanLength() > 6:
                        self._dragging = True
                if self._dragging:
                    self.move(gp - self._drag_pos)
                    return True
            if gp.x() >= fg.right() - margin and gp.y() >= fg.bottom() - margin:
                self.setCursor(Qt.SizeFDiagCursor)
            elif gp.x() >= fg.right() - margin:
                self.setCursor(Qt.SizeHorCursor)
            elif gp.y() >= fg.bottom() - margin:
                self.setCursor(Qt.SizeVerCursor)
            else:
                self.setCursor(Qt.ArrowCursor)
        elif event.type() == event.MouseButtonRelease:
            self._drag_pos = None
            self._dragging = False
            self._resize_edge = None
            self.setCursor(Qt.ArrowCursor)
        return super().eventFilter(obj, event)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        gradient = QLinearGradient(0, 0, 0, self.height())
        gradient.setColorAt(0, QColor(42, 58, 95))
        gradient.setColorAt(1, QColor(24, 32, 58))
        painter.setBrush(gradient)
        painter.setPen(Qt.NoPen)
        painter.drawRoundedRect(QRectF(self.rect()), 22, 22)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        path = QPainterPath()
        path.addRoundedRect(QRectF(self.rect()), 22, 22)
        self.setMask(QRegion(path.toFillPolygon().toPolygon()))
        QTimer.singleShot(0, self._update_scroll_size)


