# ── 安装 / 应用 ──────────────────────────────────────
def _run(cmd, timeout=1800):
    """跑一条命令，返回 (ok, 输出)。找不到命令不抛异常，交给调用方报错。"""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode == 0, (r.stdout or "") + (r.stderr or "")
    except FileNotFoundError:
        return False, "找不到命令：" + cmd[0]
    except subprocess.TimeoutExpired:
        return False, "超时（%ds）：%s" % (timeout, " ".join(cmd))
    except Exception as ex:
        return False, str(ex)


def install_component(pkg_path):
    """把一个组件包装进当前 wine。

    先试 wc-apply 的 store（组件已经在 store 里了，直接应用）；
    没有就退回 DXVK 那套做法：把包装直接解到 windows/ 目录。
    """
    target = get_wine_target_dir()
    if not target:
        return False, "找不到 wine：请先确认 %s 里的 WINEPREFIX" % CONF_FILE

    name = os.path.basename(pkg_path.rstrip("/"))
    for suf in (".tar.xz", ".tar.gz"):
        if name.endswith(suf):
            name = name[:-len(suf)]
            break

    # 首选：组件进 store，再由 wc-apply 应用到 prefix（会写 overrides / 注册表）
    wc_apply = find_tool("wc-apply")
    wc_install = find_tool("wc-install")
    if wc_apply:
        store = store_dir()
        if not os.path.isdir(os.path.join(store, name)) and wc_install:
            ok, out = _run([wc_install, "--store", store, name])
            if not ok:
                return False, _first_line(out, "wc-install 失败")
        if os.path.isdir(os.path.join(store, name)):
            return _apply_one(name, wc_apply)
        # store 里也没有、又不能下载，才会退到下面的解包
        if wc_install:
            return False, "组件 %s 不在 store 里，也下载不到" % name

    if wc_apply:
        pfx = wine_prefix_dir() or target
        return _apply_one(name, wc_apply, pfx)

    # 退回：直接解包到 windows/（和 DXVK 版本选择完全一样的做法）
    # 包的顶层如果就是组件名（vcredist2022_dll/system32/...），先剥掉这一层，
    # 否则会解成 windows/vcredist2022_dll/system32/ —— wine 认不到。
    try:
        os.makedirs(target, exist_ok=True)
        strip = ["--strip-components=1"] if _tar_has_root(pkg_path, name) else []
        flag = "-xJf" if pkg_path.endswith(".tar.xz") else "-xzf"
        r = subprocess.run(["tar", flag, pkg_path, "-C", target] + strip,
                           capture_output=True, text=True)
        if r.returncode == 0:
            return True, "已解包 %s 到 windows/" % name
        err = (r.stderr or "解包失败").strip().splitlines()
        return False, (err[-1] if err else "解包失败")
    except Exception as ex:
        return False, str(ex)


def _tar_has_root(pkg_path, name):
    """包里的顶层目录是不是就叫 name（那就该剥掉一层）。"""
    flag = "-tJf" if pkg_path.endswith(".tar.xz") else "-tzf"
    try:
        r = subprocess.run(["tar", flag, pkg_path], capture_output=True, text=True)
        if r.returncode != 0:
            return False
        roots = set()
        for line in r.stdout.splitlines():
            line = line.strip().lstrip("./")
            if line:
                roots.add(line.split("/")[0].rstrip("/"))
        return roots == {name}
    except Exception:
        return False



def _apply_one(name, wc_apply, pfx=None):
    """把 store 里的一个组件加进当前 prefix 的选择并应用（不丢已有选择）。"""
    pfx = pfx or wine_prefix_dir()
    if not pfx:
        return False, "找不到当前 wine prefix"
    appid = _appid_for_prefix()
    cur = read_selection_ids(appid)
    if name not in cur:
        cur.append(name)
    ok, out = _run([wc_apply, "--select", appid] + cur)
    if not ok:
        return False, _first_line(out, "写选择失败")
    compat = _compat_for_prefix(pfx)
    cmd = [wc_apply, "--prefix", pfx, appid] if compat is None else [wc_apply, compat, appid]
    ok, out = _run(cmd)
    if ok:
        if name in cur and len(cur) > 1:
            return True, "已安装 %s（共 %d 个）" % (name, len(cur))
        return True, "已安装 %s" % name
    return False, _first_line(out, "应用失败")


def read_selection_ids(appid):
    """读出当前给这个 appid 选中的组件 id 列表。

    直接问 wc-apply --list（它自己知道选择文件在哪，路径不重复硬编码）。
    """
    wc_apply = find_tool("wc-apply")
    if wc_apply:
        ok, out = _run([wc_apply, "--list"])
        if ok:
            for line in out.splitlines():
                parts = line.split(None, 1)
                if len(parts) == 2 and parts[0] == str(appid):
                    body = parts[1].strip()
                    if body.startswith("(") or not body:
                        return []
                    return [x.strip() for x in body.split(",") if x.strip()]
            return []
    # wc-apply 不在就退回读文件
    sel = os.environ.get("WC_SELECTION") or os.path.join(
        os.path.expanduser("~"), ".config", "wc-apply", "selection.json")
    try:
        with open(sel, "r") as f:
            cfg = json.load(f)
        return list(cfg.get("games", {}).get(str(appid), []))
    except Exception:
        return []


def _appid_for_prefix():
    """给这个 prefix 编一个稳定的 id，用来存选择/状态。

    用 prefix 路径的 hash，这样同一个 wine 每次都是同一个 id；
    也和 wc-apply 的默认（<compat>/pfx）区分开。
    """
    pfx = wine_prefix_dir() or get_wine_target_dir() or "?"
    h = 0
    for ch in pfx:
        h = (h * 131 + ord(ch)) & 0xFFFFFFFF
    return str(h % 100000000)


def _compat_for_prefix(pfx):
    """给 wc-apply 造一个 <dir>/pfx 结构，让它能操作裸 .wine prefix。

    wc-apply 内部写死了 pfx = compat / "pfx"；Wine 的裸 prefix 一般叫 .wine，
    名字对不上。这里在 ~/.cache 下建一个稳定的批处理目录，里面放一个 pfx
    符号链接指回真实 prefix；状态/备份文件也落在那儿，不动用户 prefix。
    已经有 pfx 名字的（Proton/compatdata 那种）直接用，不折腾。
    """
    import hashlib
    if os.path.basename(pfx.rstrip("/")) == "pfx":
        return os.path.dirname(pfx.rstrip("/"))
    key = hashlib.sha1(pfx.encode("utf-8")).hexdigest()[:12]
    base = os.path.join(os.path.expanduser("~"), ".cache", "wincomponents", key)
    os.makedirs(base, exist_ok=True)
    link = os.path.join(base, "pfx")
    try:
        if os.path.islink(link):
            if os.path.realpath(link) != os.path.realpath(pfx):
                os.unlink(link)
                os.symlink(pfx, link)
        elif not os.path.exists(link):
            os.symlink(pfx, link)
    except Exception:
        pass
    return base


def apply_selection(ids):
    """把一组组件应用进当前 prefix，返回 (ok, 文本)。"""
    wc_apply = find_tool("wc-apply")
    if not wc_apply:
        return False, "找不到 wc-apply（没装 wincomponents 工具）"
    pfx = wine_prefix_dir()
    if not pfx:
        return False, "找不到当前 wine prefix"
    appid = _appid_for_prefix()
    ok, out = _run([wc_apply, "--select", appid] + list(ids))
    if not ok:
        return False, _first_line(out, "写选择失败")
    compat = _compat_for_prefix(pfx)
    cmd = [wc_apply, "--prefix", pfx, appid] if compat is None else [wc_apply, compat, appid]
    ok, out = _run(cmd)
    if not ok:
        return False, _first_line(out, "应用失败")
    return True, "已应用 %d 个组件" % len(ids)


