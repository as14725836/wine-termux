#  环境探测：当前 wine / 当前 prefix / 组件包目录
#  和 DXVK 版本选择走完全相同的配置来源
# ════════════════════════════════════════════════════════════
PREFIX_DIR = "/data/data/com.termux/files/usr"
GLIBC_DIR = PREFIX_DIR + "/glibc"

# DXVK 版本选择读的就是这个文件；这里沿用，保证认到同一个 wine
CONF_FILE = GLIBC_DIR + "/opt/conf/wine_path.conf"

# 组件包（.tar.xz）放这里，和 usr/dxvk/*.tar.gz 平行
PKG_DIR = PREFIX_DIR + "/wincomponents"
ALLOW_PKG_DIR = PKG_DIR            # 安全闸：只允许删这个目录里的文件

# 装进 wine 的位置（相对 prefix）
WINDOWS_SUBPATH = "drive_c/windows"

# wc-install / wc-apply 在 PATH 里找不到时的兜底位置
TOOL_HINTS = [
    PREFIX_DIR + "/bin",
    "/data/data/com.termux/files/home/.local/bin",
    os.path.join(os.path.expanduser("~"), ".local/bin"),
]


def read_wine_config():
    """读 wine_path.conf，返回 (wine 目录全名, WINEPREFIX, prefix 根目录)。

    和 DXVK 版本选择同一套逻辑：拿 WINEPREFIX 的父目录名当 wine 目录名。
    extra 兜底：如果 conf 不在，就扫 glibc/ 下面看起来像 wine 的目录，挑最新的
    —— 环境是我这份模拟器，配置偶尔会被别的脚本改写，多一条路总比报错好。
    """
    wine_prefix, wine_dir_name = None, None
    try:
        if os.path.isfile(CONF_FILE):
            with open(CONF_FILE, "r") as f:
                for line in f:
                    if line.startswith("export WINEPREFIX="):
                        p = line.strip().split("=", 1)[1].strip().strip('"').strip("'")
                        p = os.path.expandvars(p)
                        wine_prefix = p
                        wine_dir_name = os.path.basename(os.path.dirname(p))
                        break
    except Exception:
        pass

    if not wine_dir_name:
        # 兜底：glibc 下最像 wine 的那个目录（mtime 最新优先）
        best, best_t = None, -1
        try:
            for d in glob.glob(GLIBC_DIR + "/*"):
                if not os.path.isdir(d):
                    continue
                low = os.path.basename(d).lower()
                if "wine" not in low and "proton" not in low:
                    continue
                t = os.path.getmtime(d)
                if t > best_t:
                    best, best_t = d, t
        except Exception:
            pass
        if best:
            wine_dir_name = os.path.basename(best)
            wine_prefix = best + "/.wine"

    if not wine_dir_name:
        return None, None, None

    root = os.path.join(GLIBC_DIR, wine_dir_name)
    if not wine_prefix:
        wine_prefix = root + "/.wine"
    return wine_dir_name, wine_prefix, root


def get_wine_root():
    return read_wine_config()[2]


def get_wine_target_dir():
    """组件要装到的 windows/ 目录 —— 和 DXVK 版本选择算出来的是同一个地方。"""
    wine_dir_name, wine_prefix, _ = read_wine_config()
    if not wine_dir_name:
        return None
    # 优先用 WINEPREFIX 自己，它才是真正在用的那个 prefix
    if wine_prefix and os.path.isdir(wine_prefix):
        return os.path.join(wine_prefix, WINDOWS_SUBPATH) + "/"
    return os.path.join(GLIBC_DIR, wine_dir_name, ".wine", WINDOWS_SUBPATH) + "/"


def wine_prefix_dir():
    """当前 prefix 根目录（.wine 那个），没有就 None。"""
    _, wine_prefix, _ = read_wine_config()
    if wine_prefix and os.path.isdir(wine_prefix):
        return wine_prefix
    root = get_wine_root()
    if root:
        p = os.path.join(root, ".wine")
        return p if os.path.isdir(p) else None
    return None


def find_tool(name):
    """找 wc-install / wc-apply；找不到返回 None。"""
    p = shutil.which(name)
    if p:
        return p
    for d in TOOL_HINTS:
        cand = os.path.join(d, name)
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def _first_line(text, default=""):
    for line in (text or "").splitlines():
        line = line.strip()
        if line:
            return line
    return default


def env_summary():
    """给界面顶部显示的一行环境信息。"""
    wine_dir_name, wine_prefix, _ = read_wine_config()
    if not wine_dir_name:
        return "未找到 wine（看 %s）" % CONF_FILE
    return "当前 wine: %s　·　prefix: %s" % (wine_dir_name, wine_prefix or "?")


