        print("  失败：%s" % err)
        return 1
    ok = [c for c in comps if component_kind(c)[0] == "file"]
    no = [c for c in comps if component_kind(c)[0] != "file"]
    print("  组件总数       : %d（来源 %s）" % (len(comps), src))
    print("  可点即装       : %d 个" % len(ok))
    print("  需要安装器     : %d 个（不列出）" % len(no))
    if ok:
        print("  例子：")
        for c in ok[:10]:
            print("    %-22s %10s  %s" % (c.get("name"), human_size(component_size(c)),
                                          (c.get("description") or "")[:38]))
