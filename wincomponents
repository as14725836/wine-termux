def hive_of(key):
    head = key.strip("\\").split("\\")[0].upper()
    return "HKCU" if head.startswith(("HKCU", "HKEY_CURRENT_USER")) else "HKLM"


def strip_hive(key):
    """registry.json holds the key without its hive: ['HKLM', 'Software\\X'] -> 'Software\\X'."""
    parts = [p for p in key.replace("/", "\\").split("\\") if p]
    if parts and parts[0].upper().startswith(("HKLM", "HKCU", "HKEY_")):
        parts = parts[1:]
    return "\\".join(parts)


def reg_type(name):
    """The catalog writes REG_SZ / REG_DWORD; wc-apply knows sz / dword."""
    return {"REG_SZ": "sz", "REG_EXPAND_SZ": "expand_sz", "REG_MULTI_SZ": "multi_sz",
            "REG_DWORD": "dword", "REG_BINARY": "binary", "REG_NONE": "key",
            "sz": "sz", "dword": "dword"}.get(str(name).upper(), "sz")


def same_bytes(a, b):
    try:
        if Path(a).stat().st_size != Path(b).stat().st_size:
            return False
    except OSError:
        return False
    with open(a, "rb") as fa, open(b, "rb") as fb:
        while True:
            x, y = fa.read(1 << 20), fb.read(1 << 20)
            if x != y:
                return False
            if not x:
                return True


def _md5(path):
    import hashlib
    h = hashlib.md5()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def unpack(archive, into):
    into = Path(into)
    into.mkdir(parents=True, exist_ok=True)
    name = archive.name.lower()
    if name.endswith((".tar.xz", ".txz")):
        with lzma.open(archive, "rb") as f, tarfile.open(fileobj=f) as tar:
            _safe_extract_tar(tar, into)
    elif name.endswith((".tar.gz", ".tgz", ".tar")):
        with tarfile.open(archive) as tar:
            _safe_extract_tar(tar, into)
    elif name.endswith(".zip"):
        with zipfile.ZipFile(archive) as z:
            for m in z.namelist():
                p = Path(m)
                if p.is_absolute() or ".." in p.parts:
                    raise SystemExit("unsafe path in zip: %s" % m)
            z.extractall(into)
    else:
        raise SystemExit("unsupported archive: %s" % archive.name)
    return into


def _safe_extract_tar(tar, into):
    base = Path(into).resolve()
    for member in tar.getmembers():
        target = (base / member.name).resolve()
        if not str(target).startswith(str(base)):
            raise SystemExit("unsafe path in tar: %s" % member.name)
    tar.extractall(into)


def resolve_tail(cache, work, url):
    """The extracted thing a catalog-relative url means, matched on its trailing parts."""
    parts = [p for p in url.strip("/").split("/") if p and p != "temp"]
    for base in (cache, work):
        cand = base
        for part in parts:
            nxt = cand / part
            if nxt.exists():
                cand = nxt
                continue
            # The part may be a tar's stem (d3dx9.tar) or absent from this tree.
            stem = part[:-4] if part.endswith(".tar") else None
            found = None
            if cand.is_dir():
                for e in cand.iterdir():
                    if stem and e.name == stem:
                        found = e
                        break
                    if e.name.lower() == part.lower():
                        found = e
                        break
            if found is None:
                cand = None
                break
            cand = found
        if cand is not None and cand.exists():
            return cand
    return None


def match(pattern, name):
    """A small shell-glob match, as the catalog's file_name fields use it."""
    if pattern in ("", "*"):
        return True
    rx = "^" + re.escape(pattern).replace(r"\*", ".*").replace(r"\?", ".") + "$"
    return re.match(rx, name, re.IGNORECASE) is not None



# ------------------------------------------------------------------ catalog

def load_catalog():
    data = fetch_json(CATALOG)
    if data.get("schemaVersion") != 1:
        raise SystemExit("unsupported catalog schemaVersion %r" % data.get("schemaVersion"))
    return data


def find(components, name):
    for c in components:
        if c.get("name") == name:
            return c
    return None


def support(c):
    """'file' when this tool can lay it out, else 'installer' with the reason."""
    steps = c.get("steps") or []
    if not steps:
        return "file", "no steps (nothing to install)"
    for s in steps:
        if s.get("action") in INSTALLER_STEPS:
            return "installer", "%s needs a Windows installer (%s)" % (c["name"], s.get("action"))
    for s in steps:
        if s.get("action") not in FILE_STEPS and s.get("action") not in LAUNCH_STEPS:
            return "installer", "%s has a step this tool does not do (%s)" % (c["name"], s.get("action"))
    if all(s.get("action") in LAUNCH_STEPS for s in steps):
        return "file", "registry/windows-version only"
    return "file", ""


# ------------------------------------------------------------------ install

def install(component, store, cache, verbose=True):
    name = component["name"]
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", name):
        raise SystemExit("unsafe component name %r" % name)
    target = Path(store) / name
    work = Path(cache) / name
    if work.exists():
        shutil.rmtree(work)
    work.mkdir(parents=True, exist_ok=True)

    overrides, registry, requires = [], [], list(component.get("dependencies") or [])
    files_placed = 0
    # The catalog's own convention: the extracted archive root is the working dir for the
    # relative 'url' fields the copy_* steps carry.
    roots = {}          # step url -> extracted dir
    default_root = work / "root"
    default_root.mkdir(exist_ok=True)

    def note(msg):
        if verbose:
            print("  " + msg)

    for index, step in enumerate(component.get("steps") or []):
        action = step.get("action")

        if action in ("archive_extract", "download_archive"):
            url = step.get("url") or ""
            src = None
            if url.startswith("http"):
                fname = step.get("file_name") or url.split("?")[0].rsplit("/", 1)[-1]
                dest = Path(cache) / fname
                if not dest.exists():
                    note("download %s" % fname)
                    download(url, dest, step.get("file_checksum"))
                else:
                    note("cached   %s" % fname)
                src = dest
            else:
                # A relative url names something an earlier step extracted. The catalog
                # writes these as its own helper scripts saw them (temp/d3dx9.tar/d3dx9/win32),
                # so match on the tail of the path rather than on the whole thing.
                src = resolve_tail(cache, work, url)
                if src is None:
                    note("skip archive %s (not found: %s)" % (action, url))
                    continue
            out = (work / "extract" / str(index)).resolve()
            note("unpack   %s" % src.name)
            unpack(src, out)
            roots[url] = out
            roots[str(index)] = out
            # The extracted tree's own top folder (d3dx9/ in d3dx9.tar.xz) is what the
            # catalog's later steps are relative to.
            tops = [e for e in sorted(out.iterdir()) if e.is_dir()]
            roots["top:" + str(index)] = tops[0] if len(tops) == 1 else out
            if step.get("dest"):
                sub = (out / step["dest"]).resolve()
                if sub.is_dir():
                    roots["dest:" + step["dest"]] = sub
            continue

        if action in ("copy_dll", "copy_file"):
            fname = step.get("file_name") or "*"
            dest = step.get("dest")
            arch_dir = dest_path(dest, action == "copy_dll")
            # The arch for source selection is the leading system32/syswow64, if any.
            arch_top = arch_dir.split("/")[0]
            source_root = None
            url = step.get("url") or ""
            if url:
                source_root = roots.get(url) or roots.get("dest:" + url)
                if source_root is None:
                    source_root = resolve_tail(cache, work, url)
                if source_root is None:
                    source_root = last_extract(work, index, roots)
            else:
                source_root = last_extract(work, index, roots)
            if source_root is None or not Path(source_root).exists():
                note("skip %s (no source for %s)" % (action, fname))
                continue
            # The source archive holds ONE arch: win32/ for i386, win64/ for x86_64. Pick
            # the one 'dest' asks for, so syswow64 gets the 32-bit DLLs and system32 the
            # 64-bit ones. A source that has no such wrapper is taken as it is.
            want = {"system32": "win64", "syswow64": "win32"}.get(arch_top)
            if want:
                sub = Path(source_root) / want
                if sub.is_dir():
                    source_root = sub
                else:
                    # Some archives nest it one level down.
                    nested = sorted(Path(source_root).glob("*/" + want))
                    if nested:
                        source_root = nested[0]
            placed = 0
            for found in sorted(Path(source_root).rglob("*")):
                if not found.is_file():
                    continue
                # 'file_name' matches the basename, as the catalog means it.
                if not match(fname, found.name):
                    continue
                outdir = target / arch_dir
                outdir.mkdir(parents=True, exist_ok=True)
                target_file = outdir / found.name
                if target_file.exists() and not same_bytes(found, target_file):
                    # A real clash: keep both, the second under its source folder name.
                    target_file = outdir / (found.parent.name + "_" + found.name)
                shutil.copy2(found, target_file)
                placed += 1
            note("%-9s %d file(s) -> %s/" % (action, placed, arch_dir))
            files_placed += placed
            continue

        if action == "override_dll":
            if "bundle" in step:
                for item in step["bundle"]:
                    if isinstance(item, dict) and item.get("value"):
                        overrides.append("%s=%s" % (item["value"], item.get("data", "native,builtin")))
            elif step.get("dll"):
                overrides.append("%s=%s" % (step["dll"], step.get("type", "native,builtin")))
            continue

        if action == "register_dll":
            for item in (step.get("dlls") or ([step["dll"]] if step.get("dll") else [])):
                if isinstance(item, str):
                    overrides.append("%s=n,b" % item)
            continue

        if action == "set_register_key":
            key = step.get("key")
            if key:
                # The catalog names it "value"; wc-apply (from upstream) reads "name".
                registry.append({"hive": step.get("hive") or hive_of(key),
                                 "key": strip_hive(key),
                                 "type": reg_type(step.get("type", "REG_SZ")),
                                 "name": step.get("value", step.get("name", "")),
                                 "data": step.get("data", "")})
            continue

        if action == "set_windows":
            ver = str(step.get("version") or "").strip()
            key = "Software\\Microsoft\\Windows\\CurrentVersion"
            table = WINDOWS_VERSIONS.get(ver.lower())
            if table:
                current, csd, build = table
                registry.append({"hive": "HKLM", "key": key, "type": "sz",
                                 "name": "CurrentVersion", "data": current})
                registry.append({"hive": "HKLM", "key": key, "type": "sz",
                                 "name": "CurrentBuild", "data": build})
                registry.append({"hive": "HKLM", "key": key, "type": "sz",
                                 "name": "CurrentBuildNumber", "data": build})
                registry.append({"hive": "HKLM", "key": key, "type": "sz",
                                 "name": "CSDVersion", "data": csd})
                note("set_windows %s -> CurrentVersion %s" % (ver, current))
            else:
                note("set_windows %s (unknown version, nothing written)" % ver)
            continue

        if action in LAUNCH_STEPS:
            note("noted    %s (done at launch by wc-apply)" % action)
            continue

    # component.json is what wc-apply reads.
    meta = {"overrides": sorted(set(overrides))}
    if requires:
        meta["requires"] = requires
    (target).mkdir(parents=True, exist_ok=True)
    if registry:
        # wc-apply (upstream) reads these from registry.json, not component.json.
        clean = []
        seen = set()
        for value in registry:
            sig = (value["hive"], value["key"].lower(), (value.get("name") or "").lower())
            if sig in seen:
                clean = [v for v in clean
                         if (v["hive"], v["key"].lower(), (v.get("name") or "").lower()) != sig]
            seen.add(sig)
            clean.append(value)
        with open(target / "registry.json", "w", encoding="utf-8") as f:
            json.dump({"values": clean}, f, indent=1, ensure_ascii=False)
            f.write("\n")
    with open(target / "component.json", "w", encoding="utf-8") as f:
        json.dump(meta, f, indent=1, ensure_ascii=False)
        f.write("\n")
    # What the runs looked like, kept beside it for troubleshooting.
    with open(target / "wc-install.json", "w", encoding="utf-8") as f:
        json.dump({"name": name, "description": component.get("description", ""),
                   "provider": component.get("provider", ""),
                   "files": files_placed, "overrides": meta["overrides"]}, f, indent=1)
        f.write("\n")
    shutil.rmtree(work, ignore_errors=True)
    return files_placed, sorted(set(overrides))




