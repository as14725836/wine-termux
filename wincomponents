WIN_VER_MAP = [
    ("10.0", "win10"), ("6.3", "win81"), ("6.2", "win8"),
    ("6.1", "win7"), ("6.0", "vista"), ("5.2", "win2003"), ("5.1", "winXP"),
]


def read_current_windows_version():
    """从 prefix 的 system.reg 里读 CurrentVersion，映射回 winXP/win7/win10。"""
    pfx = wine_prefix_dir()
    if not pfx:
        return None
    try:
        with open(os.path.join(pfx, "system.reg"), "r", errors="replace") as f:
            version, in_key = None, False
            for line in f:
                if line.startswith("["):
                    in_key = "currentversion]" in line.lower()
                    continue
                if in_key:
                    m = re.match(r'\s*"CurrentVersion"\s*=\s*"([^"]*)"', line)
                    if m:
                        version = m.group(1)
                        break
    except Exception:
        return None
    if not version:
        return None
    for prefix, name in WIN_VER_MAP:
        if version.startswith(prefix):
            return name
    return None


def write_windows_version(val):
    """把 prefix 报成 val。

    首选 wc-apply（走它的注册表写入 + 可撤销状态）；没有工具就直接改 system.reg。
    """
    if val not in ("winXP", "win7", "win10", "win81", "win8", "vista", "win2003"):
        return False
    wc_apply = find_tool("wc-apply")
    pfx = wine_prefix_dir()
    if wc_apply and pfx:
        appid = _appid_for_prefix()
        ok, _ = _run([wc_apply, "--select", appid, val])
        if ok:
            compat = _compat_for_prefix(pfx)
            cmd = [wc_apply, "--prefix", pfx, appid] if compat is None else [wc_apply, compat, appid]
            ok, _ = _run(cmd)
            if ok:
                return True
    return _write_version_direct(val)


def _write_version_direct(val):
    """没有 wc-apply 时直接改 system.reg：只动 CurrentVersion 一行。"""
    pfx = wine_prefix_dir()
    if not pfx:
        return False
    version = {"winXP": "5.1", "win2003": "5.2", "vista": "6.0", "win7": "6.1",
               "win8": "6.2", "win81": "6.3", "win10": "10.0"}.get(val)
    if not version:
        return False
    path = os.path.join(pfx, "system.reg")
    try:
        with open(path, "r", errors="replace") as f:
            lines = f.readlines()
        out, in_key, done = [], False, False
        for line in lines:
            if line.startswith("["):
                in_key = "currentversion]" in line.lower()
            elif in_key and not done:
                m = re.match(r'(\s*"CurrentVersion"\s*=\s*")[^"]*(".*)', line)
                if m:
                    line = m.group(1) + version + m.group(2)
                    done = True
            out.append(line)
        if not done:
            return False
        tmp = path + ".wcgui"
        with open(tmp, "w") as f:
            f.writelines(out)
        os.replace(tmp, path)
        return True
    except Exception:
        return False


