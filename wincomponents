TERMUX_PREFIX = "/data/data/com.termux/files/usr"
GLIBC_DIR = TERMUX_PREFIX + "/glibc"
CONF_FILE = GLIBC_DIR + "/opt/conf/wine_path.conf"
WINDOWS_SUBPATH = "drive_c/windows"


def read_wine_config():
    """读 wine_path.conf -> (wine 目录名, WINEPREFIX, wine 根目录)。"""
    import glob
    wine_prefix = wine_dir_name = None
    try:
        if os.path.isfile(CONF_FILE):
            with open(CONF_FILE, "r") as f:
                for line in f:
                    if line.startswith("export WINEPREFIX="):
                        p = line.split("=", 1)[1].strip().strip('"').strip("'")
                        p = os.path.expandvars(p)
                        wine_prefix = p
                        wine_dir_name = os.path.basename(os.path.dirname(p))
                        break
    except Exception:
        pass
    if not wine_dir_name:
        best, best_t = None, -1
        try:
            for d in glob.glob(GLIBC_DIR + "/*"):
                if not os.path.isdir(d):
                    continue
                low = os.path.basename(d).lower()
                if "wine" not in low and "proton" not in low:
                    continue
                t = os.path.getmtime(d)
                if t > best_t:
                    best, best_t = d, t
        except Exception:
            pass
        if best:
            wine_dir_name = os.path.basename(best)
            wine_prefix = best + "/.wine"
    if not wine_dir_name:
        return None, None, None
    root = os.path.join(GLIBC_DIR, wine_dir_name)
    if not wine_prefix:
        wine_prefix = root + "/.wine"
    return wine_dir_name, wine_prefix, root


def wine_prefix_dir():
    _, wine_prefix, _ = read_wine_config()
    if wine_prefix and os.path.isdir(wine_prefix):
        return wine_prefix
    _, _, root = read_wine_config()
    if root:
        p = os.path.join(root, ".wine")
        return p if os.path.isdir(p) else None
    return None


def get_wine_target_dir():
    _, wine_prefix, _ = read_wine_config()
    if not wine_prefix:
        return None
    if os.path.isdir(wine_prefix):
        return os.path.join(wine_prefix, WINDOWS_SUBPATH) + "/"
    _, _, root = read_wine_config()
    if root:
        return os.path.join(root, ".wine", WINDOWS_SUBPATH) + "/"
    return None


def env_summary():
    name, pfx, _ = read_wine_config()
    if not name:
        return "未找到 wine（看 %s）" % CONF_FILE
    return "当前 wine: %s　·　prefix: %s" % (name, pfx or "?")


# ── store / compat 布局 ─────────────────────────────────
def store_dir():
    return os.environ.get("WC_STORE") or str(DEFAULT_STORE)


def cache_dir():
    d = os.environ.get("WC_INSTALL_CACHE") or os.path.join(
        os.path.expanduser("~"), ".cache", "wincomponents", "downloads")
    os.makedirs(d, exist_ok=True)
    return d


def _compat_for_prefix(pfx):
    """wc-apply 写死 compat/pfx，这里给任意 prefix 造一个 compat 外壳。

    prefix 目录名正好是 pfx 时直接用它的父目录；否则在缓存里建
    <hash>/pfx 软链指回真 prefix，状态和备份都落在缓存里。
    """
    if not pfx:
        return None
    pfx = os.path.abspath(pfx)
    if os.path.basename(pfx) == "pfx":
        return os.path.dirname(pfx)
    import hashlib as _h
    tag = _h.sha1(pfx.encode()).hexdigest()[:12]
    base = os.path.join(os.path.expanduser("~"), ".cache", "wincomponents", tag)
    os.makedirs(base, exist_ok=True)
    link = os.path.join(base, "pfx")
    if os.path.islink(link):
        if os.path.realpath(link) != pfx:
            os.unlink(link)
            os.symlink(pfx, link)
    elif not os.path.exists(link):
        os.symlink(pfx, link)
    elif os.path.isdir(link) and os.path.realpath(link) == pfx:
        pass
    elif os.path.isdir(link):
        # 真目录占位：换成一个软链
        alt = link + ".orig"
        if not os.path.exists(alt):
            os.rename(link, alt)
        os.symlink(pfx, link)
    return base


def appid_for_prefix(pfx=None):
    """每个 prefix 一个稳定的 appid，选择/状态才能持久。"""
    pfx = pfx or wine_prefix_dir()
    if not pfx:
        return None
    import hashlib as _h
    return "p%s" % (_h.sha1(os.path.abspath(pfx).encode()).hexdigest()[:12])


def selection_file(appid=None):
    base = os.environ.get("WC_SELECTION") or os.path.join(
        os.path.expanduser("~"), ".config", "wincomponents", "selection.json")
    return base


# ── 选择读写 ──────────────────────────────────────────
def read_selection(appid):
    f = selection_file()
    try:
        with open(f, encoding="utf-8") as fh:
            cfg = json.load(fh)
    except Exception:
        return []
    if cfg.get("version") != 1:
        return []
    ids = cfg.get("games", {}).get(appid, [])
    return [i for i in ids if isinstance(i, str)] if isinstance(ids, list) else []


def write_selection(appid, ids):
    f = selection_file()
    os.makedirs(os.path.dirname(f), exist_ok=True)
    cfg = {"version": 1, "games": {}}
    if os.path.isfile(f):
        try:
            with open(f, encoding="utf-8") as fh:
                old = json.load(fh)
            if old.get("version") == 1 and isinstance(old.get("games"), dict):
                cfg = old
        except Exception:
            pass
    cfg.setdefault("games", {})[appid] = list(dict.fromkeys(ids))
    tmp = f + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(cfg, fh, indent=1)
    os.replace(tmp, f)


# ── 安装 / 应用 ───────────────────────────────────────
def installed_ids(appid, pfx=None):
    """这个 prefix 当前装了哪些组件（state 里记的）。"""
    compat = _compat_for_prefix(pfx or wine_prefix_dir())
    if not compat:
        return []
    from pathlib import Path as _P
    return load_state(_P(compat)).get("components", []) or []


def do_install(catalog, name, log=None):
    """下载并解包一个组件进 store。返回 (文件数, overrides)。"""
    comp = find(catalog, name)
    if comp is None:
        raise RuntimeError("目录里没有 %s" % name)
    kind, why = support(comp)
    if kind != "file":
        raise RuntimeError(why or "需要 Windows 安装器")
    return install(comp, store_dir(), cache_dir(), verbose=False)


def do_apply(appid, ids, pfx=None, log=None):
    """把选中的组件应用到 prefix。返回 (overrides, notes)。"""
    pfx = pfx or wine_prefix_dir()
    if not pfx:
        raise RuntimeError("没找到 wine prefix")
    compat = _compat_for_prefix(pfx)
    write_selection(appid, ids)
    from pathlib import Path as _P
    return apply(_P(compat), appid, selection=selection_file(), store=store_dir(),
                 pending=None, wait=None)


# ── Windows 版本（改 prefix 的 system.reg）────────────────
WIN_VER_MAP = [
    ("10.0", "win10"), ("6.3", "win81"), ("6.2", "win8"),
    ("6.1", "win7"), ("6.0", "vista"), ("5.2", "win2003"), ("5.1", "winXP"),
]
_WIN_VER_CODE = {"winXP": "5.1", "win2003": "5.2", "vista": "6.0", "win7": "6.1",
                 "win8": "6.2", "win81": "6.3", "win10": "10.0"}


def read_current_windows_version():
    """从 prefix 的 system.reg 读 CurrentVersion，映射回 winXP/win7/win10。"""
    pfx = wine_prefix_dir()
    if not pfx:
        return None
    version = None
    try:
        with open(os.path.join(pfx, "system.reg"), "r", errors="replace") as f:
            in_key = False
            for line in f:
                if line.startswith("["):
                    in_key = "currentversion]" in line.lower()
                    continue
                if in_key:
                    m = re.match(r'\s*"CurrentVersion"\s*=\s*"([^"]*)"', line)
                    if m:
                        version = m.group(1)
                        break
    except Exception:
        return None
    if not version:
        return None
    for pre, name in WIN_VER_MAP:
        if version.startswith(pre):
            return name
    return None


def write_windows_version(val):
    """只改 system.reg 里的 CurrentVersion 一行（够用且可逆）。"""
    pfx = wine_prefix_dir()
    if not pfx:
        return False
    version = _WIN_VER_CODE.get(val)
    if not version:
        return False
    path = os.path.join(pfx, "system.reg")
    try:
        with open(path, "r", errors="replace") as f:
            lines = f.readlines()
        out, in_key, done = [], False, False
        for line in lines:
            if line.startswith("["):
                in_key = "currentversion]" in line.lower()
            elif in_key and not done:
                m = re.match(r'(\s*"CurrentVersion"\s*=\s*")[^"]*(".*)', line)
                if m:
                    line = m.group(1) + version + m.group(2)
                    done = True
            out.append(line)
        if not done:
            return False
        tmp = path + ".wcgui"
        with open(tmp, "w") as f:
            f.writelines(out)
        os.replace(tmp, path)
        return True
    except Exception:
        return False


class FlowLayout(QLayout):
    """自动换行的流式布局"""
    def __init__(self, parent=None, margin=0, hspacing=6, vspacing=6):
        super().__init__(parent)
        self._items = []
        self._hspace = hspacing
        self._vspace = vspacing
        self.setContentsMargins(margin, margin, margin, margin)

    def addItem(self, item):
        self._items.append(item)

    def count(self):
        return len(self._items)

    def itemAt(self, index):
        if 0 <= index < len(self._items):
            return self._items[index]
        return None

    def takeAt(self, index):
        if 0 <= index < len(self._items):
            return self._items.pop(index)
        return None

    def expandingDirections(self):
        return Qt.Orientations(0)

    def hasHeightForWidth(self):
        return True

    def heightForWidth(self, width):
        return self._do_layout(QRect(0, 0, width, 0), True)

    def setGeometry(self, rect):
        super().setGeometry(rect)
        self._do_layout(rect, False)

    def sizeHint(self):
        w = 400
        if self.parent():
            pw = self.parent().width()
            if pw > 50:
                w = pw
        h = self.heightForWidth(w)
        return QSize(w, h)

    def minimumSize(self):
        m = self.contentsMargins()
        max_w = 0
        for item in self._items:
            sh = item.sizeHint()
            if sh.width() > max_w:
                max_w = sh.width()
        return QSize(max_w + m.left() + m.right(), 
                     m.top() + m.bottom() + 20)

    def _do_layout(self, rect, test_only):
        m = self.contentsMargins()
        x = rect.x() + m.left()
        y = rect.y() + m.top()
        line_height = 0
        right = rect.right() - m.right()
        if right <= m.left():
            right = m.left() + 400

        for item in self._items:
            wid = item.widget()
            if not wid or not wid.isVisible():
                continue
            size_hint = item.sizeHint()
            w = size_hint.width()
            h = size_hint.height()
            if w <= 0:
                continue

            if x + w > right and line_height > 0:
                x = rect.x() + m.left()
                y += line_height + self._vspace
                line_height = 0

            if not test_only:
                item.setGeometry(QRect(QPoint(x, y), QSize(w, h)))

            x += w + self._hspace
            line_height = max(line_height, h)

        return y + line_height - rect.y() + m.bottom()


