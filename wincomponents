def dest_path(dest, is_dll=True):
    """The component-local directory a copy step's 'dest' means."""
    dest = (dest or "").replace("\\", "/").strip("/")
    if not dest:
        return "system32" if is_dll else "windows"
    parts = dest.split("/")
    parts[0] = {"win64": "system32", "win32": "syswow64", "system32": "system32",
                "syswow64": "syswow64", "windows": "windows"}.get(parts[0].lower(), parts[0])
    out = []
    for part in parts:
        if part == "..":
            if out:
                out.pop()
        elif part not in ("", "."):
            out.append(part)
    joined = "/".join(out)
    # Anything that climbed out of windows/ belongs under drive_c instead.
    if joined.startswith("../") or not joined.startswith(("system32", "syswow64", "windows")):
        return "drive_c/" + joined.lstrip("./")
    return joined


def fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "wc-install"})
    with urllib.request.urlopen(req, timeout=120) as r:
        return json.loads(r.read().decode("utf-8"))


def download(url, dest, checksum=None):
    dest = Path(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    req = urllib.request.Request(url, headers={"User-Agent": "wc-install"})
    total = 0
    with urllib.request.urlopen(req, timeout=600) as r, open(dest, "wb") as out:
        size = int(r.headers.get("Content-Length") or 0)
        while True:
            chunk = r.read(1 << 20)
            if not chunk:
                break
            out.write(chunk)
            total += len(chunk)
            if size:
                pct = total * 100 // size
                sys.stderr.write("\r  %s %d%% (%d/%d)" % (dest.name, pct, total, size))
        if size:
            sys.stderr.write("\r" + " " * 60 + "\r")
    if checksum:
        got = _md5(dest)
        if got != checksum.lower():
            raise SystemExit("checksum mismatch for %s: %s != %s" % (dest.name, got, checksum))
    return dest


def last_extract(work, index, roots):
    """The tree the most recent archive_extract produced, with its single top folder applied."""
    keys = sorted(roots, key=lambda k: int(k) if k.isdigit() else -1)
    if keys:
        last = keys[-1]
        return roots.get("top:" + last, roots[last])
    return None


