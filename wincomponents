    # ===== 单实例：QLocalServer 保证同时只有一个窗口 =====
    from PyQt5.QtNetwork import QLocalServer, QLocalSocket

    SOCK_NAME = 'xmobox_wincomponents_installer'

    def _try_activate_existing():
        sock = QLocalSocket()
        sock.connectToServer(SOCK_NAME)
        if sock.waitForConnected(300):
            try:
                sock.write(b'SHOW\n')
                sock.flush()
                sock.waitForBytesWritten(300)
                sock.disconnectFromServer()
            except Exception:
                pass
            return True
        return False

    if _try_activate_existing():
        sys.exit(0)

    try:
        QLocalServer.removeServer(SOCK_NAME)
    except Exception:
        pass
    server = QLocalServer()
    server.listen(SOCK_NAME)

    dlg = WinComponentsDialog()
    dlg.bind_single_instance_server(server)
    dlg.exec_()

    if app is not None:
        sys.exit(0)

