# --- standalone defaults (this copy is not DroidDeck) -------------------------------
# Every path can be overridden: WC_STORE / WC_SELECTION / WC_PENDING, or the [[store]] and
# [[selection]] keys of ~/.config/wc-apply/config.ini.
def _env_path(name, default):
    value = os.environ.get(name)
    return Path(value).expanduser() if value else Path(default).expanduser()

def _ini():
    import configparser
    conf = configparser.ConfigParser()
    conf.read([str(_env_path("WC_CONFIG", "~/.config/wc-apply/config.ini"))])
    return conf

_CONF = _ini()

def _conf_path(section, key, env, default):
    if os.environ.get(env):
        return Path(os.environ[env]).expanduser()
    if _CONF.has_option(section, key):
        return Path(_CONF.get(section, key)).expanduser()
    return Path(default).expanduser()

STORE = _conf_path("store", "path", "WC_STORE", "~/.local/share/wincomponents")
SELECTION = _conf_path("selection", "path", "WC_SELECTION", "~/.config/wc-apply/selection.json")
# Components still being downloaded, in DroidDeck's format. Only read when it exists, and the
# launch waits PENDING_WAIT seconds for what it names - 0 turns the wait off.
PENDING = _conf_path("selection", "pending", "WC_PENDING", "~/.config/wc-apply/pending.json")
PENDING_WAIT = float(os.environ.get("WC_PENDING_WAIT", _CONF.get("selection", "pending_wait", fallback="0") or 0))
# What this prefix holds from us, so a component turned off is taken out again.
STATE = ".wc-apply.json"
# A file ours replaced that was not Wine's own, put back when the component is turned off.
# Wine's builtins need no copy: it restores those itself.
BACKUP = ".wc-apply-backup"
BUILTIN_MARKS = (b"Wine builtin DLL", b"Wine placeholder DLL")
ARCH_DIRS = ("system32", "syswow64")
ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
HIVES = {"HKLM": "system.reg", "HKCU": "user.reg"}
VALUE_TYPES = {"key", "sz", "expand_sz", "multi_sz", "dword", "binary", "append", "prepend"}


def valid_id(value):
    return isinstance(value, str) and ID.fullmatch(value) is not None and ".." not in value


def wanted(app_id, selection=SELECTION):
    try:
        with open(selection, encoding="utf-8") as source:
            config = json.load(source)
    except FileNotFoundError:
        return []
    if config.get("version") != 1:
        raise ValueError("unsupported components selection")
    ids = config.get("games", {}).get(app_id, [])
    if not isinstance(ids, list) or not all(valid_id(i) for i in ids):
        raise ValueError("invalid components selection")
    return ids


def component(store, cid):
    """The component's overrides, its files as (relative path, source) and the ids it bundles, or None if not installed."""
    root = Path(store) / cid
    try:
        with open(root / "component.json", encoding="utf-8") as source:
            meta = json.load(source)
    except (FileNotFoundError, ValueError):
        return None
    files = []
    for arch in ARCH_DIRS:
        folder = root / arch
        if folder.is_dir():
            # A few go one level down (gmdls: system32/drivers/gm.dls).
            for entry in sorted(folder.rglob("*")):
                if entry.is_file() and not entry.is_symlink():
                    rel = entry.relative_to(folder).as_posix().lower()
                    files.append(("drive_c/windows/%s/%s" % (arch, rel), entry))
    drive = root / "drive_c"
    if drive.is_dir():
        for entry in sorted(drive.rglob("*")):
            if entry.is_file() and not entry.is_symlink():
                files.append(("drive_c/" + entry.relative_to(drive).as_posix(), entry))
    requires = [r for r in meta.get("requires", []) if valid_id(r)]
    return [str(o) for o in meta.get("overrides", [])], files, requires, registry_values(root)


def registry_values(root):
    """The component's registry values (registry.json), the ones that are well formed."""
    try:
        with open(Path(root) / "registry.json", encoding="utf-8") as source:
            values = json.load(source).get("values", [])
    except (FileNotFoundError, ValueError, AttributeError):
        return []
    good = []
    for value in values if isinstance(values, list) else []:
        if isinstance(value, dict) and value.get("hive") in HIVES and isinstance(value.get("key"), str) \
                and value.get("type") in VALUE_TYPES and value["key"].strip("\\") and "\0" not in value["key"]:
            good.append(value)
    return good


def expand(store, ids):
    """The picks with everything they bundle, each once, a bundle's parts before it."""
    out, seen = [], set()

    def visit(cid, depth):
        if cid in seen or depth > 8:
            return
        seen.add(cid)
        found = component(store, cid)
        for dep in (found[2] if found else []):
            visit(dep, depth + 1)
        out.append(cid)

    for cid in ids:
        visit(cid, 0)
    return out


def spelled(path):
    """path with each folder that exists spelled as the prefix spells it (Windows names ignore case)."""
    parts = path.parts
    current = Path(parts[0])
    for part in parts[1:]:
        candidate = current / part
        if not candidate.exists():
            try:
                with os.scandir(current) as entries:
                    for entry in entries:
                        if entry.name.lower() == part.lower() and entry.is_dir():
                            candidate = current / entry.name
                            break
            except OSError:
                pass
        current = candidate
    return current


def existing(path):
    """The file at path as the prefix spells it: Windows names ignore case, the filesystem may not."""
    folder = spelled(path.parent)
    path = folder / path.name
    try:
        with os.scandir(folder) as entries:
            for entry in entries:
                if entry.name.lower() == path.name.lower():
                    return folder / entry.name
    except OSError:
        pass
    return None


def same(src, dst):
    try:
        if dst.is_symlink():
            return False
        a, b = src.stat(), dst.stat()
    except OSError:
        return False
    return a.st_size == b.st_size and int(a.st_mtime) == int(b.st_mtime)


def builtin(path):
    """Proton's own: a symlink into its files, or a Wine DLL that says so in its DOS stub."""
    if path.is_symlink():
        return True
    try:
        with open(path, "rb") as source:
            head = source.read(512)
    except OSError:
        return False
    return any(mark in head for mark in BUILTIN_MARKS)


def place(src, target, backup=None):
    """Copies src over target unless it is already there; a file of someone else's goes to backup first."""
    target = spelled(target.parent) / target.name
    target.parent.mkdir(parents=True, exist_ok=True)
    found = existing(target)
    if found is not None and same(src, found):
        return False
    if found is not None and backup is not None and not backup.exists() and not builtin(found):
        backup.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(found, backup)
    final = found or target
    temp = final.with_name(".%s.droiddeck" % final.name)
    shutil.copy2(src, temp)
    # Over a Proton builtin this swaps its symlink for our file.
    os.replace(temp, final)
    return True


# ---------------------------------------------------------------- the prefix's registry files

def reg_escape(text, extra=""):
    """A string as Wine's registry files write it."""
    out = []
    for ch in text:
        if ch == "\\" or ch == '"' or ch in extra:
            out.append("\\" + ch)
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        elif ch == "\0":
            out.append("\\0")
        elif ch < " " or ch > "~":
            out.append("\\x%04x" % ord(ch))
        else:
            out.append(ch)
    return "".join(out)


def reg_unescape(text):
    out, i = [], 0
    while i < len(text):
        ch = text[i]
        if ch != "\\" or i + 1 >= len(text):
            out.append(ch)
            i += 1
            continue
        nxt = text[i + 1]
        if nxt == "x":
            match = re.match(r"[0-9a-fA-F]{1,4}", text[i + 2:])
            if match:
                out.append(chr(int(match.group(0), 16)))
                i += 2 + len(match.group(0))
                continue
        out.append({"n": "\n", "r": "\r", "t": "\t", "0": "\0"}.get(nxt, nxt))
        i += 2
    return "".join(out)


def reg_key_line(key):
    return "[%s]" % "\\\\".join(reg_escape(part, "[]") for part in key.strip("\\").split("\\"))


def reg_value_line(name, kind, data):
    """name=data as one registry file line; None for a kind that has no line of its own."""
    head = "@" if name == "" else '"%s"' % reg_escape(name)
    if kind == "sz":
        return '%s="%s"' % (head, reg_escape(str(data)))
    if kind == "expand_sz":
        return '%s=str(2):"%s"' % (head, reg_escape(str(data)))
    if kind == "multi_sz":
        parts = [str(part) for part in data] if isinstance(data, list) else [str(data)]
        return '%s=str(7):"%s"' % (head, reg_escape("".join(part + "\0" for part in parts)))
    if kind == "dword":
        return "%s=dword:%08x" % (head, int(data) & 0xFFFFFFFF)
    if kind == "binary":
        digits = re.sub(r"[^0-9a-f]", "", str(data).lower())
        return "%s=hex:%s" % (head, ",".join(digits[i:i + 2] for i in range(0, len(digits) - 1, 2)))
    return None


def reg_string(line):
    """The text of a string value line (plain or str(2)), or None for any other kind."""
    match = re.match(r'^(?:@|"(?:[^"\\]|\\.)*")=(?:str\(2\):)?"((?:[^"\\]|\\.)*)"\s*$', line)
    return reg_unescape(match.group(1)) if match else None


class RegistryFile:
    """One of a prefix's registry files, as Wine keeps them: [key] sections of name=value lines."""

    def __init__(self, path):
        self.path = Path(path)
        with open(self.path, encoding="utf-8", errors="surrogateescape", newline="") as source:
            self.lines = source.read().split("\n")
        self.changed = False
        self.index = {}
        self.links = {}
        root = ""
        for line in self.lines[:4]:
            match = re.match(r"^;; All keys relative to (.*)$", line)
            if match:
                root = reg_unescape(match.group(1)).strip("\\").lower()
        current = None
        for number, line in enumerate(self.lines):
            if line.startswith("["):
                key = self.parse_key(line)
                current = key
                if key is not None:
                    self.index.setdefault(key.lower(), number)
            elif line == "#link" and current is not None:
                target = self.link_target(number, root)
                if target:
                    self.links[current.lower()] = target

    def link_target(self, number, root):
        """Where the link key whose "#link" line is at number leads, relative to this file's root."""
        for at in range(number + 1, min(number + 8, len(self.lines))):
            line = self.lines[at]
            if line.startswith("["):
                return None
            if line.startswith('"SymbolicLinkValue"=hex(6):'):
                data = line.split(":", 1)[1]
                while data.endswith("\\") and at + 1 < len(self.lines):
                    at += 1
                    data = data[:-1] + self.lines[at].strip()
                try:
                    raw = bytes(int(part, 16) for part in data.split(",") if part.strip())
                    target = raw.decode("utf-16-le").strip("\\")
                except ValueError:
                    return None
                if root and target.lower().startswith(root + "\\"):
                    return target[len(root) + 1:]
                return None
        return None

    def resolve(self, key):
        """The key Wine really keeps key in: a path through a link key leads to the link's target."""
        key = key.strip("\\")
        for _ in range(8):
            lower = key.lower()
            for link, target in self.links.items():
                if lower == link or lower.startswith(link + "\\"):
                    key = target + key[len(link):]
                    break
            else:
                return key
        return key

    @staticmethod
    def parse_key(line):
        end, i = None, 1
        while i < len(line):
            if line[i] == "\\":
                i += 2
                continue
            if line[i] == "]":
                end = i
                break
            i += 1
        return None if end is None else reg_unescape(line[1:end])

    def section(self, key):
        """(start, end) line numbers of the key's values, or None."""
        start = self.index.get(self.resolve(key).lower())
        if start is None:
            return None
        end = start + 1
        while end < len(self.lines) and not self.lines[end].startswith("["):
            end += 1
        return start + 1, end

    @staticmethod
    def value_name(line):
        if line.startswith("@="):
            return ""
        match = re.match(r'^"((?:[^"\\]|\\.)*)"=', line)
        return reg_unescape(match.group(1)).lower() if match else None

    def find(self, key, name):
        """(first, last + 1) of the value's lines, or None."""
        span = self.section(key)
        if span is None:
            return None
        wanted = name.lower()
        number = span[0]
        while number < span[1]:
            line = self.lines[number]
            last = number
            while self.lines[last].endswith("\\") and last + 1 < span[1]:
                last += 1
            if self.value_name(line) == wanted:
                return number, last + 1
            number = last + 1
        return None

    def get(self, key, name):
        found = self.find(key, name)
        return None if found is None else "\n".join(self.lines[found[0]:found[1]])

    def ensure_key(self, key):
        key = self.resolve(key)
        if key.lower() in self.index:
            return
        now = time.time()
        while self.lines and self.lines[-1] == "":
            self.lines.pop()
        self.lines += ["", "%s %d" % (reg_key_line(key), int(now)),
                       "#time=%x" % (int(now * 10000000) + 116444736000000000)]
        self.index[key.lower()] = len(self.lines) - 2
        self.lines.append("")
        self.changed = True

    def put(self, key, name, raw):
        """Sets the value's line(s) to raw, or removes the value when raw is None; True if that changed it."""
        found = self.find(key, name)
        if raw is None:
            if found is None:
                return False
            del self.lines[found[0]:found[1]]
            self.shift(found[0], found[0] - found[1])
            self.changed = True
            return True
        new = raw.split("\n")
        if found is not None:
            if self.lines[found[0]:found[1]] == new:
                return False
            self.lines[found[0]:found[1]] = new
            self.shift(found[0], len(new) - (found[1] - found[0]))
        else:
            self.ensure_key(key)
            start, end = self.section(key)
            while end > start and self.lines[end - 1] == "":
                end -= 1
            self.lines[end:end] = new
            self.shift(end, len(new))
        self.changed = True
        return True

    def shift(self, at, by):
        if by:
            for key, number in self.index.items():
                if number >= at:
                    self.index[key] = number + by

    def save(self):
        if not self.changed:
            return
        temp = self.path.with_name("." + self.path.name + ".droiddeck")
        with open(temp, "w", encoding="utf-8", errors="surrogateescape", newline="") as out:
            out.write("\n".join(self.lines))
        shutil.copymode(self.path, temp)
        os.replace(temp, self.path)
        self.changed = False


def list_line(name, current, item, separator, add, at_end=True):
    """current (a string value line) with item added to or taken out of its list, None if it had
    nothing else; a value that is not a string is left as it is."""
    text = reg_string(current) if current is not None else ""
    if text is None:
        return current
    items = [part for part in text.split(separator) if part and part.lower() != item.lower()]
    if add:
        items = items + [item] if at_end else [item] + items
    if not items:
        return None
    expand = current is None or "=str(2):" in current
    return reg_value_line(name, "expand_sz" if expand else "sz", separator.join(items))


def apply_registry(pfx, values, state):
    """Writes the picked components' registry values into the prefix and takes out the ones of
    components turned off: a value goes back to what it was before, an entry added to a list such
    as PATH just leaves the list. Returns (values written, notes)."""
    files = {}
    for hive, name in HIVES.items():
        if (pfx / name).is_file():
            files[hive] = RegistryFile(pfx / name)
    old = state.get("registry") if isinstance(state.get("registry"), dict) else {}
    keep, notes, written, waiting = {}, [], 0, 0
    for cid, value in values:
        reg = files.get(value["hive"])
        if reg is None:
            waiting += 1
            continue
        if value["type"] == "key":
            reg.ensure_key(value["key"])
            continue
        name = value.get("name") or ""
        ident = "%s\t%s\t%s" % (value["hive"], value["key"].lower(), name.lower())
        current = reg.get(value["key"], name)
        record = keep.get(ident) or (old.get(ident) if isinstance(old.get(ident), dict) else None) or {"prev": current}
        if value["type"] in ("append", "prepend"):
            line = list_line(name, current, str(value.get("data", "")), value.get("separator") or ";", True,
                             value["type"] == "append")
            record = dict(record, item=str(value.get("data", "")), separator=value.get("separator") or ";")
        else:
            line = reg_value_line(name, value["type"], value.get("data"))
        if line != current and reg.put(value["key"], name, line):
            written += 1
        keep[ident] = dict(record, cid=cid, hive=value["hive"], key=value["key"], name=name)
    for ident, record in old.items():
        if ident in keep or not isinstance(record, dict) or not isinstance(record.get("key"), str):
            continue
        reg = files.get(record.get("hive"))
        if reg is None:
            keep[ident] = record
            continue
        name = record.get("name") or ""
        if "item" in record:
            line = list_line(name, reg.get(record["key"], name), record["item"], record.get("separator") or ";", False)
        else:
            line = record.get("prev")
        if reg.put(record["key"], name, line):
            written += 1
    for reg in files.values():
        reg.save()
    state["registry"] = keep
    if waiting:
        notes.append("%d registry value(s) wait for the prefix: they go in on the next launch" % waiting)
    return written, notes

def load_state(compat):
    try:
        with open(compat / STATE, encoding="utf-8") as source:
            state = json.load(source)
        return state if isinstance(state.get("files"), dict) else {"files": {}}
    except (FileNotFoundError, ValueError, AttributeError):
        return {"files": {}}


def save_state(compat, state):
    temp = compat / (STATE + ".tmp")
    with open(temp, "w", encoding="utf-8") as out:
        json.dump(state, out, indent=1, sort_keys=True)
    os.replace(temp, compat / STATE)


def pending_for(app_id, pending=PENDING):
    """The component ids the app is still getting ready for app_id; empty when none (or no file)."""
    try:
        with open(pending, encoding="utf-8") as source:
            ids = json.load(source).get("games", {}).get(str(app_id), [])
    except (OSError, ValueError, AttributeError):
        return []
    return [i for i in ids if valid_id(i)] if isinstance(ids, list) else []


def wait_for_pending(app_id, pending=PENDING, store=STORE, timeout=PENDING_WAIT, sleep=time.sleep, clock=time.monotonic):
    """Waits (at most timeout seconds) for the components still being got ready for app_id to be in
    the store or dropped from the pending list. No wait at all when nothing is pending. Returns a
    note for the log, or None."""
    def missing():
        return [cid for cid in pending_for(app_id, pending) if component(store, cid) is None]
    left = missing()
    if not left:
        return None
    asked = list(left)
    start = clock()
    while left and clock() - start < timeout:
        sleep(0.5)
        left = missing()
    waited = int((clock() - start) * 1000)
    if left:
        return "wincomp: %s launched without %s (not ready)" % (app_id, ",".join(left))
    return "wincomp: %s waited %dms for %s" % (app_id, waited, ",".join(asked))


def apply(compat_path, app_id, selection=SELECTION, store=STORE, pending=PENDING, wait=wait_for_pending):
    """Brings the prefix in line with the game's picks. Returns (overrides, notes)."""
    compat = Path(compat_path)
    pfx = compat / "pfx"
    # A game Steam installed during this session may have components still on their way.
    waited = wait(app_id, pending, store) if wait else None
    ids = wanted(app_id, selection)
    state = load_state(compat)
    if not ids and not state["files"] and not state.get("registry"):
        return [], []
    notes, overrides, keep = ([waited] if waited else []), [], {}
    copied = 0
    installed = []
    values = []
    for cid in expand(store, ids):
        found = component(store, cid)
        if found is None:
            notes.append("%s is not installed; skipped" % cid)
            continue
        installed.append(cid)
        names, files, _, registry = found
        overrides += names
        values += [(cid, value) for value in registry]
        for rel, src in files:
            # A file this prefix already has from us is ours to replace; anything else is kept.
            if place(src, pfx / rel, None if rel in state["files"] else compat / BACKUP / rel):
                copied += 1
            keep[rel] = cid
    removed = restored = 0
    for rel, cid in state["files"].items():
        if rel in keep:
            continue
        path = existing(pfx / rel)
        saved = compat / BACKUP / rel
        if saved.is_file():
            target = path or (pfx / rel)
            os.replace(saved, target)
            restored += 1
        elif path is not None and not path.is_symlink():
            path.unlink()
            removed += 1
    if removed:
        # Proton refreshes its builtins only when its config changes; forgetting the config puts
        # its own DLLs back where ours were on the next launch - this one.
        try:
            (compat / "config_info").unlink()
        except FileNotFoundError:
            pass
    compat.mkdir(parents=True, exist_ok=True)
    new_state = {"files": keep, "components": installed, "registry": state.get("registry", {})}
    written = 0
    if values or new_state["registry"]:
        written, registry_notes = apply_registry(pfx, values, new_state)
        notes += registry_notes
    save_state(compat, new_state)
    if copied or removed or restored or written:
        note = "components %s: %d file(s) placed, %d removed" % (",".join(ids) or "none", copied, removed)
        note += ", %d put back as they were" % restored if restored else ""
        notes.append(note + (", %d registry value(s) written" % written if written else ""))
    return overrides, notes


def overrides_value(names):
    """WINEDLLOVERRIDES entries: native-then-builtin unless the component says otherwise; the last word on a DLL wins."""
    modes = {}
    for entry in names:
        name, _, mode = entry.partition("=")
        name = name.strip().lower()
        if not name or not re.fullmatch(r"[a-z0-9._-]+", name):
            continue
        # The catalog writes the modes both ways: Wine's letters (n,b) and the long names
        # (native,builtin). WINEDLLOVERRIDES takes either, but only the letters survive a
        # round trip through some launchers, so the long form is shortened here.
        mode = (mode if "=" in entry else "n,b").strip().lower()
        letters = ""
        for word in (w.strip() for w in mode.split(",")):
            letters += {"native": "n", "builtin": "b", "disabled": "", "": ""}.get(word, word)
        if not re.fullmatch(r"[nb]*", letters):
            continue
        modes.pop(name, None)
        modes[name] = letters or "n,b"
    return ";".join("%s=%s" % item for item in modes.items())


# ------------------------------------------------------------------ catalog cache
CATALOG_TTL = 6 * 3600

def _cache_dir():
    d = Path(os.environ.get("WC_CACHE", str(Path.home() / ".cache/wincomponents")))
    d.mkdir(parents=True, exist_ok=True)
    return d

def catalog_cache_file():
    return _cache_dir() / "components.json"

def fetch_catalog(force=False, timeout=25):
    """catalog 带磁盘缓存（6 小时）。返回 (components, source)。"""
    cf = catalog_cache_file()
    if not force and cf.is_file():
        age = time.time() - cf.stat().st_mtime
        if age < CATALOG_TTL:
            try:
                data = json.loads(cf.read_text(encoding="utf-8"))
                comps = data["components"] if isinstance(data, dict) else data
                return comps, "cache"
            except Exception:
                pass
    last = None
    for url in (CATALOG, CATALOG_MIRROR):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "wincomponents/1.0"})
            with urllib.request.urlopen(req, timeout=timeout) as r:
                raw = r.read()
            data = json.loads(raw.decode("utf-8"))
            comps = data["components"] if isinstance(data, dict) else data
            cf.write_bytes(raw)
            return comps, "net"
        except Exception as e:
            last = e
    raise RuntimeError("拿不到组件目录：%s" % last)


def component_size(c):
    """组件大概要下多少字节。"""
    total = 0
    for s in c.get("steps") or []:
        u = s.get("url") or ""
        if not u.startswith("http"):
            continue
        try:
            total = max(total, int(s.get("file_size") or 0))
        except (TypeError, ValueError):
            pass
    return total


def component_kind(c):
    """-> ('file'|'installer', reason)"""
    return support(c)


