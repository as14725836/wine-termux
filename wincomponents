# ════════════════════════════════════════════════════════════
#  数据层：catalog 拉取 / 下载安装 / 应用到 prefix
# ════════════════════════════════════════════════════════════
def catalog_components(force=False):
    """拿组件目录（带 6 小时磁盘缓存）。"""
    try:
        comps, src = fetch_catalog(force=force)
        return comps, src, None
    except Exception as e:
        return [], "err", str(e)


def human_size(n):
    try:
        n = float(n)
    except Exception:
        return "?"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return ("%.0f %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024.0


def _worker(fn):
    """把 fn 丢到后台线程；返回 (thread, result_box)。"""
    import threading
    box = {"done": False, "result": None, "error": None}

    def run():
        try:
            box["result"] = fn()
        except Exception as e:
            box["error"] = e
        finally:
            box["done"] = True

    t = threading.Thread(target=run, daemon=True)
    t.start()
    return t, box


def install_one(name, appid, catalog, pfx=None):
    """下载 + 解包 + 应用到 prefix。返回一句给人看的话。"""
    pfx = pfx or wine_prefix_dir()
    if not pfx:
        return False, "没找到 wine prefix"
    do_install(catalog, name)
    ids = read_selection(appid)
    if name not in ids:
        ids.append(name)
    ov, notes = do_apply(appid, ids, pfx=pfx)
    return True, "已安装 %s" % name


def remove_one(name, appid, pfx=None):
    pfx = pfx or wine_prefix_dir()
    if not pfx:
        return False, "没找到 wine prefix"
    ids = [i for i in read_selection(appid) if i != name]
    do_apply(appid, ids, pfx=pfx)
    return True, "已卸载 %s" % name

