        lab_win.setObjectName("setLabel")
        row_win.addWidget(lab_win)
        self.win_group = QButtonGroup(self)
        self.win_group.setExclusive(True)
        self.win_btns = {}
        for i, (val, desc) in enumerate(WIN_VER_BUTTONS):
