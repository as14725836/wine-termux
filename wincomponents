        lab_cfg.setObjectName("setLabel")
        row_cfg.addWidget(lab_cfg)
        for label, ids in BUNDLES:
            b = QPushButton(label)
            b.setObjectName("setBtn")
            b.setToolTip("装：" + ", ".join(ids))
            b.clicked.connect(lambda ch, i=ids, l=label: self._install_bundle(l, i))
            row_cfg.addWidget(b)
