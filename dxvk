class DxvkDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self._drag_pos = None
        self._drag_start_global = None
        self._dragging = False
        self.all_versions = list_versions()
        self._server = None
        self.init_ui()

    def bind_single_instance_server(self, server):
        """把 QLocalServer 挂到窗口上：有新连接就把自己置顶"""
        self._server = server

        def _on_new_conn():
            conn = server.nextPendingConnection()
            if conn is None:
                return
            try:
                if self.isMinimized():
                    self.showNormal()
                self.show()
                self.raise_()
                self.activateWindow()
            finally:
                conn.disconnectFromServer()
                conn.deleteLater()

        server.newConnection.connect(_on_new_conn)

    def init_ui(self):
        self.setWindowTitle("DXVK 版本选择")
        # 底部多了「帧数 / 配置」两行，默认高度按屏幕可用高度自适应
        _scr = QApplication.primaryScreen()
        _avail_h = _scr.availableGeometry().height() if _scr is not None else 800
        self.resize(760, min(780, int(_avail_h * 0.92)))
        self.setMinimumSize(380, 380)
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Window)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setStyleSheet(STYLE)

        layout = QVBoxLayout()
        layout.setContentsMargins(16, 12, 16, 12)
        layout.setSpacing(6)

        # 搜索框
        self.search_edit = QLineEdit()
        self.search_edit.setPlaceholderText("搜索版本...")
        self.search_edit.textChanged.connect(self._filter)
        layout.addWidget(self.search_edit)

        # 状态
        self.status_label = QLabel()
        self.status_label.setObjectName("statusLabel")
        self.status_label.setAlignment(Qt.AlignCenter)
        layout.addWidget(self.status_label)

        # 流式卡片区域
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(False)
        self.scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.scroll.setFrameShape(QFrame.NoFrame)

        self.flow_widget = QWidget()
        self.flow_widget.setStyleSheet("background: transparent;")
        self.flow = FlowLayout(self.flow_widget, margin=0, hspacing=7, vspacing=7)
        self.scroll.setWidget(self.flow_widget)
        layout.addWidget(self.scroll, 1)

        # ── 帧数限制（原 dxvkte，点了就生效，窗口不关） ──
        row_rate = QHBoxLayout()
        row_rate.setSpacing(6)
        lab_rate = QLabel("帧数")
        lab_rate.setObjectName("setLabel")
        row_rate.addWidget(lab_rate)
        self.rate_group = QButtonGroup(self)
        self.rate_group.setExclusive(True)
        self.rate_btns = {}
        cur_rate = read_frame_rate()
        for i, (val, desc) in enumerate(RATE_OPTIONS):
            b = QPushButton(desc)
            b.setObjectName("setBtn")
            b.setCheckable(True)
            b.setToolTip("export DXVK_FRAME_RATE=" + val)
            if val == cur_rate:
                b.setChecked(True)
            self.rate_group.addButton(b, i)
            self.rate_btns[val] = b
            row_rate.addWidget(b)
            b.clicked.connect(lambda ch, v=val: self._set_rate(v))
        row_rate.addStretch()

        # ── 配置档切换（原 dxvkqt，点了就生效，窗口不关） ──
        row_cfg = QHBoxLayout()
        row_cfg.setSpacing(6)
        lab_cfg = QLabel("配置")
        lab_cfg.setObjectName("setLabel")
        row_cfg.addWidget(lab_cfg)
        self.cfg_group = QButtonGroup(self)
        self.cfg_group.setExclusive(True)
