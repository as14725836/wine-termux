class _DelConfirm(QDialog):
    """删除确认窗：自绘深蓝渐变 + 圆角，可拖动，可回车/ESC"""

    def __init__(self, fname, size_txt, is_current=False, parent=None):
        super().__init__(parent)
        self._drag = None
        self._yes = False
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Window | Qt.WindowStaysOnTopHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setStyleSheet(_DEL_STYLE)
        self.setMinimumWidth(520)

        lay = QVBoxLayout(self)
        lay.setContentsMargins(30, 26, 30, 22)
        lay.setSpacing(12)

        t = QLabel("删除文件（当前正在使用的版本）" if is_current else "删除文件")
        t.setObjectName("delTitle")
        lay.addWidget(t)

        n = QLabel(fname)
        n.setObjectName("delName")
        n.setWordWrap(True)
        lay.addWidget(n)

        s = QLabel("%s　·　%s" % (size_txt, "当前版本" if is_current else "安装包"))
        s.setObjectName("delMeta")
        lay.addWidget(s)

        if is_current:
            w = QLabel("删掉只是删了这个包，已装好的内容还在，\n只是以后不能再从它重装了。")
            w.setObjectName("delWarn")
            w.setWordWrap(True)
            lay.addWidget(w)

        row = QHBoxLayout()
        row.addStretch()
        no = QPushButton("取消")
        no.setObjectName("delCancelBtn")
        no.setDefault(True)
        no.clicked.connect(self.reject)
        row.addWidget(no)
        yes = QPushButton("删除")
        yes.setObjectName("delOkBtn")
        yes.clicked.connect(self._ok)
        row.addWidget(yes)
        lay.addLayout(row)

        self.adjustSize()
        try:
            scr = QApplication.primaryScreen().availableGeometry()
            self.move(scr.center().x() - self.width() // 2,
                      scr.center().y() - self.height() // 2)
        except Exception:
            pass

    def _ok(self):
        self._yes = True
        self.accept()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        g = QLinearGradient(0, 0, 0, self.height())
        g.setColorAt(0, QColor(42, 58, 95))
        g.setColorAt(1, QColor(24, 32, 58))
        p.setBrush(g)
        p.setPen(Qt.NoPen)
        p.drawRoundedRect(QRectF(self.rect()), 22, 22)

    def resizeEvent(self, event):
        super().resizeEvent(event)
        path = QPainterPath()
        path.addRoundedRect(QRectF(self.rect()), 22, 22)
        self.setMask(QRegion(path.toFillPolygon().toPolygon()))

    def mousePressEvent(self, event):
        if event.button() == Qt.LeftButton:
            self._drag = event.globalPos() - self.frameGeometry().topLeft()

    def mouseMoveEvent(self, event):
        if self._drag is not None and event.buttons() == Qt.LeftButton:
            self.move(event.globalPos() - self._drag)

    def mouseReleaseEvent(self, event):
        self._drag = None

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_Escape:
            self.reject()
        elif event.key() in (Qt.Key_Return, Qt.Key_Enter):
            self._ok()
        else:
            super().keyPressEvent(event)


def _ask_delete(fname, size, is_current=False, parent=None):
    """弹自绘的删除确认窗。返回 True = 用户点了「删除」"""
    try:
        dlg = _DelConfirm(fname, _human_size(size), is_current, parent)
        dlg.exec_()
        return bool(dlg._yes)
    except Exception:
        # 兜底：万一自绘窗出不来，宁可弹个难看的系统框，也不能删错/删不了
        try:
            from PyQt5.QtWidgets import QMessageBox
            box = QMessageBox(parent)
            box.setWindowTitle("删除文件")
            box.setIcon(QMessageBox.Warning if is_current else QMessageBox.Question)
            box.setText("直接删除这个文件？")
            box.setInformativeText("%s\n%s" % (fname, _human_size(size)))
            yes = box.addButton("删除", QMessageBox.AcceptRole)
            no = box.addButton("取消", QMessageBox.RejectRole)
            box.setDefaultButton(no)
            box.exec_()
            return box.clickedButton() is yes
        except Exception:
            return False


