        with open(DXVKQT_CONF, "r") as f:
            for line in f:
                m = re.search(r'^export DXVK_CONFIG_FILE=\$PREFIX/glibc/opt/(\S+)', line)
                if m:
                    return m.group(1)
    except Exception:
        pass
    return None


def write_config_file(target_file):
    # 目标行取消注释、其余同族行注释掉；一行都没有就在末尾补一行
    try:
        with open(DXVKQT_CONF, "r") as f:
            lines = f.readlines()
    except Exception:
        lines = []          # 文件不存在/读不了：按空文件处理，末尾会补上目标行
    hit = False
    new_lines = []
    for line in lines:
        stripped = line.strip()
        if (stripped.startswith("export DXVK_CONFIG_FILE=")
                or stripped.startswith("#export DXVK_CONFIG_FILE=")):
            clean = stripped.lstrip('#')
            if target_file in clean:
                hit = True
                if stripped.startswith("#"):
                    line = line.lstrip('#')
            else:
                if not stripped.startswith("#"):
                    line = "#" + line
        new_lines.append(line)
    if not hit:
        if new_lines and not new_lines[-1].endswith("\n"):
            new_lines[-1] += "\n"
        new_lines.append("export DXVK_CONFIG_FILE=$PREFIX/glibc/opt/" + target_file + "\n")
    try:
        os.makedirs(os.path.dirname(DXVKQT_CONF), exist_ok=True)
        with open(DXVKQT_CONF, "w") as f:
            f.writelines(new_lines)
        return True
    except Exception:
        return False


