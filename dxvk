def read_frame_rate():
    try:
        with open(DXVKTE_CONF, "r") as f:
            for line in f:
                m = re.match(r'^export DXVK_FRAME_RATE=(.*)', line)
                if m:
                    return m.group(1).strip()
    except Exception:
        pass
    return "0"


def write_frame_rate(val):
    # 原 dxvkte 只改已存在的行；这里补一个兜底：文件/行不存在就新建 + 追加
    try:
        with open(DXVKTE_CONF, "r") as f:
            content = f.read()
    except Exception:
        content = ""
    if re.search(r'^export DXVK_FRAME_RATE=.*', content, flags=re.MULTILINE):
        content = re.sub(r'^export DXVK_FRAME_RATE=.*',
                         'export DXVK_FRAME_RATE=' + str(val),
                         content, flags=re.MULTILINE)
    else:
        if content and not content.endswith("\n"):
            content += "\n"
        content += 'export DXVK_FRAME_RATE=' + str(val) + "\n"
    try:
        os.makedirs(os.path.dirname(DXVKTE_CONF), exist_ok=True)
        with open(DXVKTE_CONF, "w") as f:
            f.write(content)
        return True
    except Exception:
        return False


