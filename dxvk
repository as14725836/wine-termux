        v.setSpacing(4)
        for nm, path, cur in norm:
            cb = QCheckBox()
            cb.setObjectName("pickBox")
            txt = nm + ("　★当前" if cur else "")
            try:
                txt += "　·　" + _human_size(os.path.getsize(path))
            except Exception:
                pass
            cb.setText(txt)
            cb.setToolTip(path)
            cb.toggled.connect(self._sync)
            v.addWidget(cb)
            self._boxes.append((cb, path, nm, cur))
        v.addStretch()
        area.setWidget(holder)
