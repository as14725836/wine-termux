def delete_package(path, parent=None, is_current=False):
    """直接删除一个包文件。返回 (是否已删除, 提示文字)"""
    try:
        path = os.path.abspath(str(path))
        if not os.path.exists(path):
            return False, "文件不存在：" + os.path.basename(path)
        if not os.path.isfile(path):
            return False, "不是普通文件，没删"
        if ALLOW_PKG_DIR and os.path.dirname(path) != os.path.abspath(ALLOW_PKG_DIR):
            return False, "不在允许目录里，没删"
        name = os.path.basename(path)
        try:
            size = os.path.getsize(path)
        except Exception:
            size = 0
        if DELETE_CONFIRM and parent is not None:
            if not _ask_delete(name, size, is_current, parent):
                return False, "已取消"
        os.remove(path)
        return True, "已删除 %s（%s）" % (name, _human_size(size))
    except Exception as ex:
        return False, "删除失败：%s" % ex


DXVK_DIR = "/data/data/com.termux/files/usr/dxvk"
CONF_FILE = "/data/data/com.termux/files/usr/glibc/opt/conf/wine_path.conf"


def get_wine_target_dir():
    """从配置文件获取 wine 的目标目录"""
    try:
        if not os.path.isfile(CONF_FILE):
            return None
        
        with open(CONF_FILE, "r") as f:
            for line in f:
                if line.startswith("export WINEPREFIX="):
                    wine_prefix_path = line.strip().split("=", 1)[1].strip().strip('"').strip("'")
                    wine_prefix_path = os.path.expandvars(wine_prefix_path)
                    # 直接从 WINEPREFIX 路径提取 wine 目录全名
                    wine_dir_name = os.path.basename(os.path.dirname(wine_prefix_path))
                    target_dir = f"/data/data/com.termux/files/usr/glibc/{wine_dir_name}/.wine/drive_c/windows/"
                    return target_dir
        return None
    except:
        return None


def extract_dxvk(source_file):
    """解压 DXVK 到 wine 目录"""
    target_dir = get_wine_target_dir()
    if not target_dir:
        return False
    
    try:
        os.makedirs(target_dir, exist_ok=True)
        
        result = subprocess.run(
            ["tar", "-xzf", source_file, "-C", target_dir],
            capture_output=True,
            text=True
        )
        
        return result.returncode == 0
    except:
        return False


def list_versions():
    """列出所有可用的压缩包版本"""
    versions = []
    if os.path.isdir(DXVK_DIR):
        for f in sorted(os.listdir(DXVK_DIR)):
            if f.endswith(".tar.gz"):
                name = f[:-7]  # 去掉 .tar.gz
                source_path = os.path.join(DXVK_DIR, f)
                versions.append((name, source_path))
    return versions


